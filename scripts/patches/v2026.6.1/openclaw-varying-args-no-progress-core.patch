+        stream: "lifecycle",
+        data: {
+          phase: "end",
+          endedAt: Date.now(),
+          stopReason: "run_safety",
+          livenessState: "blocked",
+          terminationReason: reason,
+        },
+      });
+      await paramsInput.onRunSafetyTerminal?.(reason);
+    },
+  });
