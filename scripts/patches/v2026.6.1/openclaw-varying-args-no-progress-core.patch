+    !detector.valid ||
+    !toolName.valid ||
+    !observedCount.valid ||
+    !limit.valid ||
+    !toolCallReservationCount.valid ||
+    !providerDispatchCount.valid ||
+    !cumulativeEstimatedPromptTokens.valid
+  ) {
+    return undefined;
+  }
