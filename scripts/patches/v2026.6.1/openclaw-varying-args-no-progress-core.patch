+        budgetScopeId: `scope-${index}`,
+        rootRunId: `run-${index}`,
+      });
+      expect(registration.ok).toBe(true);
+    }
+
+    const overflow = registry.registerRoot({
+      rootInvocationId: "root-overflow",
+      budgetScopeId: "scope-overflow",
+      rootRunId: "run-overflow",
