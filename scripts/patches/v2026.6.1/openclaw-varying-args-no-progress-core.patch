+  onDrained?: (reason: RunSafetyTermination) => void;
+};
+
+type ClaimInheritedRunParams = {
+  context: RunSafetyContext;
+  parentRunId: string;
+  childSessionKey: string;
+  provisionalRunId: string;
+  kind: RunSafetyInheritedRunKind;
