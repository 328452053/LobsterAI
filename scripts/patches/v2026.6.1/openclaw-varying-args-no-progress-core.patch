@@ -0,0 +1,20 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+
+type RunSafetyProviderDispatchContext = {
+  disableInternalTransportRetries: true;
+};
+
+const activeRunSafetyProviderDispatch = new AsyncLocalStorage<RunSafetyProviderDispatchContext>();
+
+/**
+ * Marks provider work that has already consumed one run-safety dispatch
+ * reservation. Provider transports must not hide an additional real request
+ * behind that single reservation.
+ */
+export function runWithRunSafetyProviderDispatch<T>(fn: () => T): T {
+  return activeRunSafetyProviderDispatch.run({ disableInternalTransportRetries: true }, fn);
+}
+
+export function shouldDisableInternalProviderTransportRetries(): boolean {
+  return activeRunSafetyProviderDispatch.getStore()?.disableInternalTransportRetries === true;
+}
