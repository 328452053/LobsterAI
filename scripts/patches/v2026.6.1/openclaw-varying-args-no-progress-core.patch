+        const rootOwnerAlreadyReturned =
+          entry?.identity.rootInvocationId === rootInvocationId &&
+          !entry.activeRuns.has(entry.rootRunId);
+        const finalize = () => {
+          try {
+            params.onDrained?.(reason);
