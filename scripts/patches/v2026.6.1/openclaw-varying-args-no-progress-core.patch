+    }
+
+    const claim = entry.claims.get(params.claimToken);
+    const activeRun = entry.activeRuns.get(params.runId);
+    if (
+      !claim ||
+      claim.consumed ||
+      claim.childSessionKey !== params.childSessionKey ||
+      claim.provisionalRunId !== params.runId ||
+      activeRun?.claimToken !== params.claimToken
