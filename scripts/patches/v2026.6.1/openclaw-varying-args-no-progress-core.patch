+++ b/src/agents/embedded-agent-runner/run/run-safety-gate.ts
@@ -0,0 +1,258 @@
+import { runWithRunSafetyProviderDispatch } from "../../../llm/run-safety-provider-dispatch-context.js";
+import type { AssistantMessage, Model } from "../../../llm/types.js";
+import { createAssistantMessageEventStream } from "../../../llm/utils/event-stream.js";
+import {
+  estimateRunSafetyPromptObservation,
+  type RunSafetyController,
+  type RunSafetyTermination,
+  RunSafetyTerminationKind,
+} from "../../run-safety-controller.js";
+import type {
+  Agent,
+  BeforeToolCallBatchContext,
+  BeforeToolCallBatchDecision,
+  StreamFn,
+} from "../../runtime/index.js";
+
+const RUN_SAFETY_TOOL_BLOCK_MESSAGE =
+  "Tool execution was blocked by the local run safety controller.";
+const RUN_SAFETY_PROVIDER_BLOCK_MESSAGE =
+  "Provider dispatch was blocked by the local run safety controller.";
+
+export class RunSafetyProviderGateError extends Error {
+  constructor(readonly terminationReason: RunSafetyTermination) {
+    super(RUN_SAFETY_PROVIDER_BLOCK_MESSAGE);
+    this.name = "RunSafetyProviderGateError";
+  }
+}
+
+function filterAssistantToolCalls(
+  context: BeforeToolCallBatchContext,
+  allowedRawIndexes: ReadonlySet<number>,
+): BeforeToolCallBatchContext {
+  let rawIndex = -1;
+  const content = context.assistantMessage.content.filter((block) => {
+    if (block.type !== "toolCall") {
+      return true;
+    }
+    rawIndex += 1;
+    return allowedRawIndexes.has(rawIndex);
+  });
+  return {
+    ...context,
+    assistantMessage: {
+      ...context.assistantMessage,
+      content,
+    },
+    toolCalls: context.toolCalls.filter((_, index) => allowedRawIndexes.has(index)),
+  };
+}
+
+export function installRunSafetyAgentHooks(params: {
+  agent: Agent;
+  controller: RunSafetyController;
+  runId: string;
+}): void {
+  const priorBeforeToolCallBatch = params.agent.beforeToolCallBatch;
+  const priorAfterToolCallBatch = params.agent.afterToolCallBatch;
+  const priorShouldStopAfterTurn = params.agent.shouldStopAfterTurn;
+  const priorBatchesByMessage = new WeakMap<
+    object,
+    {
+      context: BeforeToolCallBatchContext;
+      decisions: readonly BeforeToolCallBatchDecision[];
+    }
+  >();
+
+  params.agent.beforeToolCallBatch = async (context, signal) => {
+    const toolBatchId = params.controller.createToolBatchId(params.runId);
+    const safetyDecisions = params.controller.reserveToolBatch({
+      runId: params.runId,
+      toolBatchId,
+      toolCalls: context.toolCalls.map((toolCall) => ({
+        toolCallId: toolCall.id,
+        toolName: toolCall.name,
+      })),
+    });
+    const allowedOriginalIndexes = safetyDecisions
+      .filter((decision) => decision.allowed)
+      .map((decision) => decision.rawIndex);
+    const priorContext = filterAssistantToolCalls(context, new Set(allowedOriginalIndexes));
+    let priorDecisions: readonly BeforeToolCallBatchDecision[] = [];
+    try {
+      if (priorBeforeToolCallBatch && priorContext.toolCalls.length > 0) {
+        priorDecisions = (await priorBeforeToolCallBatch(priorContext, signal)) ?? [];
+        priorBatchesByMessage.set(context.assistantMessage, {
+          context: priorContext,
+          decisions: priorDecisions,
+        });
+      }
+    } catch (error) {
+      for (const decision of safetyDecisions) {
+        if (decision.allowed) {
+          params.controller.completeToolReservation(decision.reservationId);
+        }
+      }
+      throw error;
+    }
+    const priorByOriginalRawIndex = new Map<number, BeforeToolCallBatchDecision>();
+    for (const decision of priorDecisions) {
+      const originalRawIndex = allowedOriginalIndexes[decision.rawIndex];
+      if (originalRawIndex !== undefined) {
+        priorByOriginalRawIndex.set(originalRawIndex, decision);
+      }
+    }
+
+    const mergedDecisions: BeforeToolCallBatchDecision[] = [];
+    for (const decision of safetyDecisions) {
+      if (!decision.allowed) {
+        const terminationReason = decision.reason;
+        mergedDecisions.push({
+          rawIndex: decision.rawIndex,
+          reservationId: decision.reservationId,
+          block: true,
+          reason: RUN_SAFETY_TOOL_BLOCK_MESSAGE,
+          details: {
+            deniedReason: "run-safety",
+            safetyKind: terminationReason?.kind,
+            terminationReason,
+          },
+          terminate: true,
+        });
+        continue;
+      }
+      const priorDecision = priorByOriginalRawIndex.get(decision.rawIndex);
+      mergedDecisions.push(
+        priorDecision
+          ? {
+              ...priorDecision,
+              rawIndex: decision.rawIndex,
+              reservationId: decision.reservationId,
+            }
+          : {
+              rawIndex: decision.rawIndex,
+              reservationId: decision.reservationId,
+            },
+      );
+    }
+    return mergedDecisions;
+  };
+
+  params.agent.afterToolCallBatch = async (context, signal) => {
+    const priorBatch = priorBatchesByMessage.get(context.assistantMessage);
+    priorBatchesByMessage.delete(context.assistantMessage);
+    try {
+      if (priorAfterToolCallBatch && priorBatch) {
+        await priorAfterToolCallBatch(
+          {
+            ...priorBatch.context,
+            decisions: priorBatch.decisions,
+          },
+          signal,
+        );
+      }
+    } finally {
+      for (const decision of context.decisions) {
+        if (decision.reservationId) {
+          params.controller.completeToolReservation(decision.reservationId);
+        }
+      }
+    }
+  };
+
+  params.agent.shouldStopAfterTurn = async (context) => {
+    if (params.controller.terminationReason) {
+      return true;
+    }
+    return (await priorShouldStopAfterTurn?.(context)) ?? false;
+  };
+}
+
+function createProviderGateErrorStream(model: Model, reason: RunSafetyTermination) {
+  const stream = createAssistantMessageEventStream();
+  const message: AssistantMessage = {
+    role: "assistant",
+    content: [],
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    usage: {
+      input: 0,
+      output: 0,
+      cacheRead: 0,
+      cacheWrite: 0,
+      totalTokens: 0,
+      cost: {
+        input: 0,
+        output: 0,
+        cacheRead: 0,
+        cacheWrite: 0,
+        total: 0,
+      },
+    },
+    stopReason: "error",
+    errorMessage: `${RUN_SAFETY_PROVIDER_BLOCK_MESSAGE} (${reason.kind})`,
+    timestamp: Date.now(),
+  };
+  stream.push({ type: "error", reason: "error", error: message });
+  return stream;
+}
+
+export function wrapStreamFnWithRunSafety(params: {
+  streamFn: StreamFn;
+  controller: RunSafetyController;
+  runId: string;
+}): StreamFn {
+  return async (model, context, options) => {
+    const providerDispatchId = params.controller.createProviderDispatchId(params.runId);
+    const reservation = params.controller.reserveProviderDispatch({
+      runId: params.runId,
+      providerDispatchId,
+    });
+    if (!reservation.allowed) {
+      const reason =
+        reservation.reason ??
+        params.controller.tryTerminate({
+          kind: RunSafetyTerminationKind.RunSafetyStateUnavailable,
+          runId: params.runId,
+        });
+      return createProviderGateErrorStream(model, reason);
+    }
+
+    const originalOnPayload = options?.onPayload;
+    const onPayload: NonNullable<NonNullable<typeof options>["onPayload"]> = async (
+      payload,
+      payloadModel,
+    ) => {
+      const replacement = await originalOnPayload?.(payload, payloadModel);
+      const finalPayload = replacement ?? payload;
+      params.controller.observeProviderPromptEstimate({
+        providerDispatchId,
+        observation: estimateRunSafetyPromptObservation(finalPayload, payloadModel),
+      });
+      return replacement;
+    };
+
+    try {
+      const stream = await runWithRunSafetyProviderDispatch(() =>
+        params.streamFn(model, context, {
+          ...options,
+          maxRetries: 0,
+          onPayload,
+        }),
+      );
+      void stream.result().then(
+        () => params.controller.completeProviderDispatch(providerDispatchId),
+        () => params.controller.completeProviderDispatch(providerDispatchId),
+      );
+      return stream;
+    } catch (error) {
+      params.controller.completeProviderDispatch(providerDispatchId);
+      const terminationReason = params.controller.terminationReason;
+      if (terminationReason) {
+        return createProviderGateErrorStream(model, terminationReason);
+      }
+      throw error;
+    }
+  };
+}
