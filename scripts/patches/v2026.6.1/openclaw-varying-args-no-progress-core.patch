+    claim.consumed = true;
+    return {
+      ok: true,
+      context: entry.context,
+      identity: entry.identity,
+      kind: claim.kind,
+    };
+  }
+
+  cancelInheritedClaim(params: CancelInheritedClaimParams): boolean {
+    const entry = this.findMatchingActiveScope(params.context);
+    const claim = entry?.claims.get(params.claimToken);
+    if (!entry || !claim || claim.consumed) {
+      return false;
+    }
+    entry.claims.delete(params.claimToken);
