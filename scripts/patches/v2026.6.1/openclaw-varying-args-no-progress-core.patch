+  (typeof RunSafetyTerminationKind)[keyof typeof RunSafetyTerminationKind];
+
+export const RunSafetyBudgetDefaults = {
+  maxToolCallReservationsPerBudgetScope: 64,
+  maxProviderDispatchesPerBudgetScope: 32,
+  warningRatio: 0.75,
