+import {
+  estimateRunSafetyPromptObservation,
+  type RunSafetyTermination,
+} from "../agents/run-safety-controller.js";
+import type {
+  ContextEngineCompactParams,
+  ContextEngineRunSafetyHostV1,
+  ContextEngineRuntimeContext,
+} from "./types.js";
+
+export const ContextEngineRunSafetyContractVersion = {
+  V1: 1,
+} as const;
+
+export class ContextEngineRunSafetyContractError extends Error {
+  constructor(
+    message: string,
+    readonly terminationReason?: RunSafetyTermination,
+  ) {
+    super(message);
+    this.name = "ContextEngineRunSafetyContractError";
+  }
+}
+
+export function createContextEngineRunSafetyHostV1(
+  runtimeContext: ContextEngineRuntimeContext | undefined,
+): ContextEngineRunSafetyHostV1 {
+  const runSafety = runtimeContext?.runSafety;
+  const runId = runtimeContext?.runId?.trim();
+  if (!runSafety?.controller || !runId) {
+    throw new ContextEngineRunSafetyContractError(
+      "Plugin-owned compaction requires a host-owned run-safety scope and run id.",
+    );
+  }
+
+  const dispatch: ContextEngineRunSafetyHostV1["dispatch"] = async ({
+    finalPayload,
+    model,
+    transport,
