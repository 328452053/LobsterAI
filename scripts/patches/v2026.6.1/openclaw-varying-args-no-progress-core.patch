+      ? params.variantWarningThreshold
+      : 2;
+    this.variantCriticalThreshold = isPositiveSafeInteger(params.variantCriticalThreshold)
+      ? Math.max(params.variantCriticalThreshold, this.variantWarningThreshold + 1)
+      : 3;
+    this.onTelemetry =
+      params.onTelemetry ??
+      ((record) => {
+        logDebug(`run-safety: ${JSON.stringify(record)}`);
+      });
+    this.onDrained = params.onDrained;
+  }
+
+  createToolBatchId(runId: string, providerDispatchId?: string): string {
+    this.toolBatchSequence += 1;
+    return `${providerDispatchId ?? runId}:tools:${this.toolBatchSequence}`;
+  }
+
+  createProviderDispatchId(runId: string): string {
+    this.providerDispatchSequence += 1;
+    return `${runId}:provider:${this.providerDispatchSequence}`;
+  }
+
+  reserveToolBatch(params: {
+    runId: string;
+    toolBatchId: string;
+    toolCalls: readonly RunSafetyToolCallInput[];
+  }): RunSafetyToolReservationDecision[] {
+    const existingTerminal = this.promoteContinuationClosed(params.runId);
+    if (existingTerminal) {
+      return params.toolCalls.map((_, rawIndex) => ({
+        allowed: false,
+        rawIndex,
+        reservationId: `${params.toolBatchId}:${rawIndex}`,
+        reason: existingTerminal,
+      }));
+    }
+
+    const decisions: RunSafetyToolReservationDecision[] = [];
+    for (let rawIndex = 0; rawIndex < params.toolCalls.length; rawIndex += 1) {
+      const call = params.toolCalls[rawIndex];
+      const reservationId = `${params.toolBatchId}:${rawIndex}`;
+      const existing = this.toolReservations.get(reservationId);
+      if (existing) {
+        decisions.push({ ...existing.decision, duplicate: true });
+        continue;
+      }
+      if (this.scopeTerminalReasonValue || this.statusValue !== "active") {
+        decisions.push({
+          allowed: false,
+          rawIndex,
+          reservationId,
+          reason:
+            this.scopeTerminalReasonValue ??
+            this.buildTermination(RunSafetyTerminationKind.RunSafetyStateUnavailable, params.runId),
+        });
+        continue;
+      }
+      if (this.toolCallReservationCountValue >= this.limits.maxToolCallReservationsPerBudgetScope) {
+        const reason = this.tryTerminate({
+          kind: RunSafetyTerminationKind.RunToolBudget,
+          runId: params.runId,
+          toolName: call?.toolName,
+          observedCount: this.toolCallReservationCountValue,
+          limit: this.limits.maxToolCallReservationsPerBudgetScope,
+        });
+        decisions.push({ allowed: false, rawIndex, reservationId, reason });
+        continue;
+      }
+
+      this.toolCallReservationCountValue += 1;
+      const decision: RunSafetyToolReservationDecision = {
+        allowed: true,
+        rawIndex,
+        reservationId,
+      };
+      this.toolReservations.set(reservationId, { decision, completed: false });
+      decisions.push(decision);
+      this.recordWarning(
+        "tool_call_reservations",
+        this.toolCallReservationCountValue,
+        this.limits.maxToolCallReservationsPerBudgetScope,
+      );
+      if (
+        this.toolCallReservationCountValue === this.limits.maxToolCallReservationsPerBudgetScope
+      ) {
+        this.tryTerminate({
+          kind: RunSafetyTerminationKind.RunToolBudget,
+          runId: params.runId,
+          toolName: call?.toolName,
+          observedCount: this.toolCallReservationCountValue,
+          limit: this.limits.maxToolCallReservationsPerBudgetScope,
+        });
