+      runSafety: paramsInput.runSafety,
+    });
+  }
+
+  const loopDetectionConfig = paramsInput.config?.tools?.loopDetection;
+  const registration = runSafetyRegistry.registerRoot({
+    rootRunId: paramsInput.runId,
