+    return true;
+  }
+
+  finalizeScope(
+    context: RunSafetyContext,
+    kind: RunSafetyScopeEndKind = RunSafetyScopeEndKind.NormalCompletion,
+  ): boolean {
+    const entry = this.findMatchingActiveScope(context);
+    if (!entry) {
+      return false;
+    }
+    this.activeScopes.delete(entry.identity.budgetScopeId);
+    entry.activeRuns.clear();
