+
+    this.activeScopes.set(budgetScopeId, {
+      context,
+      identity: { rootInvocationId, budgetScopeId },
+      rootRunId: params.rootRunId,
+      activeRuns: new Map([[params.rootRunId, { kind: "root" }]]),
+      claims: new Map(),
+    });
