+import { beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { type RunSafetyController, RunSafetyTerminationKind } from "../run-safety-controller.js";
+import { makeAttemptResult } from "./run.overflow-compaction.fixture.js";
+import {
+  loadRunOverflowCompactionHarness,
+  mockedGlobalHookRunner,
+  mockedRunEmbeddedAttempt,
+  overflowBaseRunParams,
+  resetRunOverflowCompactionHarnessMocks,
+} from "./run.overflow-compaction.harness.js";
+
+let runEmbeddedAgent: typeof import("./run.js").runEmbeddedAgent;
+
+describe("runEmbeddedAgent run safety", () => {
+  beforeAll(async () => {
+    ({ runEmbeddedAgent } = await loadRunOverflowCompactionHarness());
+  });
+
+  beforeEach(() => {
+    resetRunOverflowCompactionHarnessMocks();
+    mockedGlobalHookRunner.hasHooks.mockImplementation(() => false);
+  });
+
+  it("bootstraps a trusted default scope and returns a typed terminal without retrying", async () => {
+    let controller: RunSafetyController | undefined;
+    mockedRunEmbeddedAttempt.mockImplementationOnce(async (input) => {
+      const attempt = input as {
+        runId: string;
+        runSafety?: { controller: RunSafetyController };
+      };
+      controller = attempt.runSafety?.controller;
+      expect(controller).toBeDefined();
+      controller?.tryTerminate({
+        kind: RunSafetyTerminationKind.RunProviderDispatchBudget,
+        runId: attempt.runId,
+      });
+      return makeAttemptResult({
+        assistantTexts: [],
+      });
+    });
+
+    const result = await runEmbeddedAgent({
+      ...overflowBaseRunParams,
+      runId: "run-direct-entry-safety",
+      config: {
+        agents: {
+          defaults: {
+            runSafety: {
+              maxProviderDispatchesPerBudgetScope: 1,
+            },
+          },
+        },
+      },
+    });
+
+    expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(1);
+    expect(controller?.limits.maxProviderDispatchesPerBudgetScope).toBe(1);
+    expect(result.payloads).toBeUndefined();
+    expect(result.meta).toMatchObject({
+      livenessState: "blocked",
+      stopReason: "run_safety",
+      terminationReason: {
+        kind: RunSafetyTerminationKind.RunProviderDispatchBudget,
+        runId: "run-direct-entry-safety",
+      },
+    });
+    expect(result.meta?.terminationReason?.rootInvocationId).toBeTruthy();
+    expect(result.meta?.terminationReason?.budgetScopeId).toBeTruthy();
+  });
+});
