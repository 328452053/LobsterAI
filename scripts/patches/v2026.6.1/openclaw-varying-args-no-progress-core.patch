index 000000000..a0973fc35
--- /dev/null
+++ b/packages/agent-core/src/agent.run-safety-tool-budget.test.ts
@@ -0,0 +1,210 @@
+import { Type } from "typebox";
+import { describe, expect, it, vi } from "vitest";
+import { agentLoop } from "./agent-loop.js";
+import { Agent } from "./agent.js";
+import {
+  type AssistantMessage,
+  createAssistantMessageEventStream,
+  type Message,
+  type Model,
+} from "./llm.js";
+import type {
+  AgentEvent,
+  AgentLoopConfig,
+  AgentTool,
+  BeforeToolCallBatchDecision,
+  StreamFn,
+} from "./types.js";
+
+const model: Model = {
+  id: "test-model",
+  name: "Test Model",
+  api: "test-api",
+  provider: "test-provider",
+  baseUrl: "https://example.test",
+  reasoning: false,
+  input: ["text"],
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+  contextWindow: 1000,
+  maxTokens: 1000,
+};
+
+function makeToolResponse(): AssistantMessage {
+  return {
+    role: "assistant",
+    content: [
+      { type: "toolCall", id: "call-0", name: "safe_tool", arguments: {} },
+      { type: "toolCall", id: "call-1", name: "unknown_tool", arguments: {} },
+      { type: "toolCall", id: "call-2", name: "invalid_tool", arguments: { value: "bad" } },
+    ],
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    usage: {
+      input: 0,
+      output: 0,
+      cacheRead: 0,
+      cacheWrite: 0,
+      totalTokens: 0,
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+    },
+    stopReason: "toolUse",
+    timestamp: 1,
+  };
+}
+
+function makeStreamFn(onCall: () => void): StreamFn {
+  return () => {
+    onCall();
+    const stream = createAssistantMessageEventStream();
+    queueMicrotask(() => {
+      const message = makeToolResponse();
+      stream.push({ type: "done", reason: "toolUse", message });
+      stream.end();
+    });
+    return stream;
+  };
+}
+
+describe("raw tool-call batch reservation", () => {
+  it("runs before lookup, schema validation, per-tool hooks, and side effects", async () => {
+    const order: string[] = [];
+    const providerCall = vi.fn();
+    const perToolHook = vi.fn(async () => {
+      order.push("per-tool-hook");
+      return undefined;
+    });
+    const afterBatch = vi.fn(async () => {
+      order.push("after-batch");
+    });
+    const decisions: BeforeToolCallBatchDecision[] = [
+      { rawIndex: 0, reservationId: "scope:batch:0" },
+      {
+        rawIndex: 1,
+        reservationId: "scope:batch:1",
+        block: true,
+        reason: "tool budget exhausted",
+        details: { deniedReason: "run-safety", safetyKind: "run_tool_budget" },
+        terminate: true,
+      },
+      {
+        rawIndex: 2,
+        reservationId: "scope:batch:2",
+        block: true,
+        reason: "tool budget exhausted",
+        details: { deniedReason: "run-safety", safetyKind: "run_tool_budget" },
+        terminate: true,
+      },
+    ];
+    const safeTool: AgentTool = {
+      name: "safe_tool",
+      label: "safe_tool",
+      description: "safe",
+      parameters: Type.Object({}, { additionalProperties: false }),
+      prepareArguments: (args) => {
+        order.push("prepare-arguments");
+        return args as Record<string, never>;
+      },
+      execute: async () => {
+        order.push("execute");
+        return { content: [{ type: "text", text: "ok" }], details: {} };
+      },
+    };
+    const invalidTool: AgentTool = {
+      name: "invalid_tool",
+      label: "invalid_tool",
+      description: "invalid",
+      parameters: Type.Object({ value: Type.Number() }, { additionalProperties: false }),
+      execute: async () => {
+        throw new Error("must not execute");
+      },
+    };
+    const config: AgentLoopConfig = {
+      model,
+      convertToLlm: (messages) => messages as Message[],
+      beforeToolCallBatch: async ({ toolCalls }) => {
+        order.push("raw-batch");
+        expect(toolCalls.map((toolCall) => toolCall.id)).toEqual(["call-0", "call-1", "call-2"]);
+        return decisions;
+      },
+      afterToolCallBatch: afterBatch,
+      beforeToolCall: perToolHook,
+      shouldStopAfterTurn: () => true,
+    };
+    const stream = agentLoop(
+      [{ role: "user", content: "run", timestamp: 1 }],
+      { systemPrompt: "", messages: [], tools: [safeTool, invalidTool] },
+      config,
+      undefined,
+      makeStreamFn(providerCall),
+    );
+    const events: AgentEvent[] = [];
+    for await (const event of stream) {
+      events.push(event);
+    }
+
+    expect(providerCall).toHaveBeenCalledTimes(1);
+    expect(perToolHook).toHaveBeenCalledTimes(1);
+    expect(afterBatch).toHaveBeenCalledTimes(1);
+    expect(order).toEqual([
+      "raw-batch",
+      "prepare-arguments",
+      "per-tool-hook",
+      "execute",
+      "after-batch",
+    ]);
+    const toolResults = events.find(
+      (event): event is Extract<AgentEvent, { type: "turn_end" }> => event.type === "turn_end",
+    )?.toolResults;
+    expect(toolResults).toHaveLength(3);
+    expect(toolResults?.[1]?.details).toEqual({
+      deniedReason: "run-safety",
+      safetyKind: "run_tool_budget",
+    });
+  });
+
+  it("forwards raw batch hooks through Agent and stops before prepareNextTurn", async () => {
+    const providerCall = vi.fn();
+    const beforeBatch = vi.fn(() => [
+      {
+        rawIndex: 0,
+        block: true,
+        reason: "scope closed",
+        details: { deniedReason: "run-safety" },
+        terminate: true,
+      },
+      {
+        rawIndex: 1,
+        block: true,
+        reason: "scope closed",
+        details: { deniedReason: "run-safety" },
+        terminate: true,
+      },
+      {
+        rawIndex: 2,
+        block: true,
+        reason: "scope closed",
+        details: { deniedReason: "run-safety" },
+        terminate: true,
+      },
+    ]);
+    const afterBatch = vi.fn();
+    const prepareNextTurn = vi.fn();
+    const agent = new Agent({
+      initialState: { model, tools: [] },
+      streamFn: makeStreamFn(providerCall),
+      beforeToolCallBatch: beforeBatch,
+      afterToolCallBatch: afterBatch,
+      shouldStopAfterTurn: () => true,
+      prepareNextTurn,
+    });
+
+    await agent.prompt("run");
+    await agent.waitForIdle();
+
+    expect(providerCall).toHaveBeenCalledTimes(1);
+    expect(beforeBatch).toHaveBeenCalledTimes(1);
+    expect(afterBatch).toHaveBeenCalledTimes(1);
+    expect(prepareNextTurn).not.toHaveBeenCalled();
+  });
+});
