new file mode 100644
index 000000000..abd0e2130
--- /dev/null
+++ b/src/agents/cli-runner.run-safety.test.ts
@@ -0,0 +1,238 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { runPreparedCliAgent } from "./cli-runner.js";
+import { createManagedRun, supervisorSpawnMock } from "./cli-runner.test-support.js";
+import type { PreparedCliRunContext } from "./cli-runner/types.js";
+import { FailoverError } from "./failover-error.js";
+import {
+  RunSafetyController,
+  type RunSafetyContext,
+  RunSafetyRootCoordinator,
+  RunSafetyTerminationKind,
+} from "./run-safety-controller.js";
+
+function createRunSafety(maxProviderDispatches: number): RunSafetyContext {
+  const coordinator = new RunSafetyRootCoordinator("root-cli-safety");
+  const controller = new RunSafetyController({
+    rootInvocationId: coordinator.rootInvocationId,
+    budgetScopeId: "scope-cli-safety",
+    rootRunId: "run-cli-safety",
+    limits: {
+      maxProviderDispatchesPerBudgetScope: maxProviderDispatches,
+    },
+    onDrained: (reason) => {
+      coordinator.publishTerminalOnce(reason);
+    },
+  });
+  return { coordinator, controller };
+}
+
+function buildContext(params: {
+  runSafety: RunSafetyContext;
+  provider?: string;
+  model?: string;
+  reusableSessionId?: string;
+  historyPrompt?: string;
+}): PreparedCliRunContext {
+  const provider = params.provider ?? "fake-cli";
+  const model = params.model ?? "fake-model";
+  const backend = {
+    command: "fake-agent-cli",
+    args: [],
+    resumeArgs: ["resume", "{sessionId}"],
+    output: "text" as const,
+    input: "stdin" as const,
+    serialize: true,
+    sessionMode: "existing" as const,
+  };
+  return {
+    params: {
+      sessionId: "session-cli-safety",
+      sessionKey: "agent:main:cli-safety",
+      sessionFile: "/tmp/cli-safety-session.jsonl",
+      workspaceDir: "/tmp",
+      prompt: "hello",
+      provider,
+      model,
+      timeoutMs: 10_000,
+      runId: "run-cli-safety",
+      runSafety: params.runSafety,
+    },
+    started: Date.now(),
+    workspaceDir: "/tmp",
+    backendResolved: {
+      id: provider,
+      config: backend,
+      bundleMcp: false,
+    },
+    preparedBackend: {
+      backend,
+      env: {},
+    },
+    reusableCliSession: params.reusableSessionId ? { sessionId: params.reusableSessionId } : {},
+    hadSessionFile: false,
+    contextEngineConfig: {},
+    modelId: model,
+    normalizedModel: model,
+    contextWindowInfo: {
+      tokens: 200_000,
+      source: "model",
+    },
+    systemPrompt: "system",
+    systemPromptReport: {} as PreparedCliRunContext["systemPromptReport"],
+    bootstrapPromptWarningLines: [],
+    openClawHistoryPrompt: params.historyPrompt,
+    authEpochVersion: 2,
+  };
+}
+
+function failedCliProcess() {
+  return createManagedRun({
+    reason: "exit",
+    exitCode: 1,
+    exitSignal: null,
+    durationMs: 5,
+    stdout: "",
+    stderr: "provider unavailable",
+    timedOut: false,
+    noOutputTimedOut: false,
+  });
+}
+
+beforeEach(() => {
+  supervisorSpawnMock.mockReset();
+});
+
+describe("CLI run safety provider gate", () => {
+  it("returns a typed terminal without spawning when the dispatch budget rejects", async () => {
+    const runSafety = createRunSafety(1);
+    const priorDispatchId = runSafety.controller.createProviderDispatchId("run-cli-safety");
+    const prior = runSafety.controller.reserveProviderDispatch({
+      runId: "run-cli-safety",
+      providerDispatchId: priorDispatchId,
+    });
+    expect(prior.allowed).toBe(true);
+    runSafety.controller.completeProviderDispatch(priorDispatchId);
+
+    const result = await runPreparedCliAgent(buildContext({ runSafety }));
+
+    expect(supervisorSpawnMock).not.toHaveBeenCalled();
+    expect(result.meta).toMatchObject({
+      livenessState: "blocked",
+      stopReason: "run_safety",
+      terminationReason: {
+        kind: RunSafetyTerminationKind.RunProviderDispatchBudget,
+        rootInvocationId: "root-cli-safety",
+        budgetScopeId: "scope-cli-safety",
+        runId: "run-cli-safety",
+      },
+      executionTrace: {
+        fallbackUsed: false,
+        runner: "cli",
+      },
+      completion: {
+        stopReason: "run_safety",
+      },
+    });
+  });
+
+  it("shares one controller across resume recovery and blocks the fresh retry before spawn", async () => {
+    const runSafety = createRunSafety(1);
+    supervisorSpawnMock.mockResolvedValueOnce(
+      createManagedRun({
+        reason: "no-output-timeout",
+        exitCode: null,
+        exitSignal: null,
+        durationMs: 5,
+        stdout: "",
+        stderr: "",
+        timedOut: false,
+        noOutputTimedOut: true,
+      }),
+    );
+
+    const result = await runPreparedCliAgent(
+      buildContext({
+        runSafety,
+        reusableSessionId: "stale-cli-session",
+        historyPrompt: "prior conversation",
+      }),
+    );
+
+    expect(supervisorSpawnMock).toHaveBeenCalledTimes(1);
+    expect(runSafety.controller.snapshot().providerDispatchCount).toBe(1);
+    expect(result.meta.stopReason).toBe("run_safety");
+    expect(result.meta.terminationReason?.kind).toBe(
+      RunSafetyTerminationKind.RunProviderDispatchBudget,
+    );
+  });
+
+  it("shares one controller across fallback candidates and starts no rejected candidate", async () => {
+    const runSafety = createRunSafety(1);
+    supervisorSpawnMock.mockResolvedValueOnce(failedCliProcess());
+
+    await expect(
+      runPreparedCliAgent(
+        buildContext({
+          runSafety,
+          provider: "first-cli",
+          model: "first-model",
+        }),
+      ),
+    ).rejects.toBeInstanceOf(FailoverError);
+
+    const fallbackResult = await runPreparedCliAgent(
+      buildContext({
+        runSafety,
+        provider: "fallback-cli",
+        model: "fallback-model",
+      }),
+    );
+
+    expect(supervisorSpawnMock).toHaveBeenCalledTimes(1);
+    expect(runSafety.controller.snapshot().providerDispatchCount).toBe(1);
+    expect(fallbackResult.meta.stopReason).toBe("run_safety");
+    expect(fallbackResult.meta.terminationReason?.kind).toBe(
+      RunSafetyTerminationKind.RunProviderDispatchBudget,
+    );
+  });
+
+  it("spawns after recording unavailable telemetry when the final CLI payload cannot be estimated", async () => {
+    const runSafety = createRunSafety(2);
+    supervisorSpawnMock.mockResolvedValueOnce(
+      createManagedRun({
+        reason: "exit",
+        exitCode: 0,
+        exitSignal: null,
+        durationMs: 5,
+        stdout: "ok",
+        stderr: "",
+        timedOut: false,
+        noOutputTimedOut: false,
+      }),
+    );
+    const opaqueImage = new Proxy(
+      {
+        type: "image",
+        data: "",
+        mimeType: "image/png",
+      },
+      {
+        ownKeys() {
+          throw new Error("opaque image");
+        },
+      },
+    );
+    const context = buildContext({ runSafety });
+    context.params.images = [opaqueImage] as PreparedCliRunContext["params"]["images"];
+
+    const result = await runPreparedCliAgent(context);
+
+    expect(supervisorSpawnMock).toHaveBeenCalledOnce();
+    expect(result.meta.stopReason).not.toBe("run_safety");
+    expect(runSafety.controller.terminationReason).toBeUndefined();
+    expect(runSafety.controller.snapshot().promptExposure).toMatchObject({
+      estimateUnavailableDispatchCount: 1,
+      pendingObservationDispatchCount: 0,
+    });
+  });
+});
