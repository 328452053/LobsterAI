+import { describe, expect, it } from "vitest";
+import { ToolsSchema } from "./zod-schema.agent-runtime.js";
+import { OpenClawSchema } from "./zod-schema.js";
+
+describe("tools.loopDetection variant no-progress validation", () => {
+  it("accepts managed variant detector thresholds and toggle", () => {
+    const result = OpenClawSchema.safeParse({
+      tools: {
+        loopDetection: {
+          enabled: true,
+          variantWarningThreshold: 2,
+          variantCriticalThreshold: 3,
+          detectors: {
+            variantNoProgress: true,
+          },
+        },
+      },
+    });
+
+    expect(result.success).toBe(true);
+  });
+
+  it("rejects a non-positive variant threshold", () => {
+    const result = ToolsSchema.safeParse({
+      loopDetection: {
+        variantWarningThreshold: 0,
+      },
+    });
+
+    expect(result.success).toBe(false);
+  });
+
+  it("rejects a variant critical threshold that is not above warning", () => {
+    const result = ToolsSchema.safeParse({
+      loopDetection: {
+        variantWarningThreshold: 3,
+        variantCriticalThreshold: 3,
+      },
+    });
+
+    expect(result.success).toBe(false);
+  });
+
+  it("continues rejecting unknown detector keys", () => {
+    const result = ToolsSchema.safeParse({
+      loopDetection: {
+        detectors: {
+          variantNoProgress: true,
+          broadArgumentNormalization: true,
+        },
+      },
+    });
+
+    expect(result.success).toBe(false);
+  });
+});
