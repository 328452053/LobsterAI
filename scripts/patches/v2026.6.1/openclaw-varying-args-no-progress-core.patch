@@ -0,0 +1,131 @@
+import { shouldDisableInternalProviderTransportRetries } from "../llm/run-safety-provider-dispatch-context.js";
+import type { StreamFn } from "./runtime/index.js";
+
+export const ProviderStreamPurpose = {
+  Agent: "agent",
+  Utility: "utility",
+} as const;
+
+export type ProviderStreamPurpose =
+  (typeof ProviderStreamPurpose)[keyof typeof ProviderStreamPurpose];
+
+export const ProviderRunSafetyContractVersion = {
+  V1: 1,
+} as const;
+
+export type ProviderRunSafetyTransportV1 = (params: {
+  finalPayload: unknown;
+  model: Parameters<StreamFn>[0];
+  context: Parameters<StreamFn>[1];
+  options: Parameters<StreamFn>[2];
+}) => ReturnType<StreamFn>;
+
+export type ProviderRunSafetyPreparedDispatchV1 = {
+  finalPayload: unknown;
+  transport: ProviderRunSafetyTransportV1;
+};
+
+export type ProviderRunSafetyPrepareV1 = (params: {
+  model: Parameters<StreamFn>[0];
+  context: Parameters<StreamFn>[1];
+  options: Parameters<StreamFn>[2];
+}) => ProviderRunSafetyPreparedDispatchV1 | Promise<ProviderRunSafetyPreparedDispatchV1>;
+
+const providerRunSafetyStreamFnsV1 = new WeakSet<StreamFn>();
+const providerRunSafetyUnderlyingStreamFnsV1 = new WeakMap<StreamFn, StreamFn>();
+
+export class ProviderRunSafetyContractError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "ProviderRunSafetyContractError";
+  }
+}
+
+function assertHostRunSafetyDispatchContext(
+  options: Parameters<StreamFn>[2],
+): NonNullable<NonNullable<Parameters<StreamFn>[2]>["onPayload"]> {
+  if (!shouldDisableInternalProviderTransportRetries()) {
+    throw new ProviderRunSafetyContractError(
+      "Provider run-safety V1 stream was invoked outside the host-owned dispatch scope.",
+    );
+  }
+  if (typeof options?.onPayload !== "function") {
+    throw new ProviderRunSafetyContractError(
+      "Provider run-safety V1 stream requires the host-owned final-payload gate.",
+    );
+  }
+  return options.onPayload;
+}
+
+function markProviderRunSafetyStreamFnV1(streamFn: StreamFn, underlying?: StreamFn): StreamFn {
+  providerRunSafetyStreamFnsV1.add(streamFn);
+  providerRunSafetyUnderlyingStreamFnsV1.set(streamFn, underlying ?? streamFn);
+  return streamFn;
+}
+
+function omitHostPayloadGate(options: Parameters<StreamFn>[2]): Parameters<StreamFn>[2] {
+  if (!options) {
+    return options;
+  }
+  const providerOptions = { ...options };
+  delete providerOptions.onPayload;
+  return providerOptions;
+}
+
+/**
+ * Build a provider-owned Agent transport whose real dispatch is host-gated.
+ *
+ * The prepare callback returns a single immutable dispatch description. The
+ * host applies and awaits its private final-payload gate before invoking the
+ * returned transport exactly once. Provider preparation must not perform
+ * network I/O; hidden retries must become new host-visible StreamFn
+ * invocations.
+ */
+export function createProviderRunSafetyStreamFnV1(prepare: ProviderRunSafetyPrepareV1): StreamFn {
+  const streamFn: StreamFn = async (model, context, options) => {
+    const onPayload = assertHostRunSafetyDispatchContext(options);
+    const providerOptions = omitHostPayloadGate(options);
+    const prepared = await prepare({
+      model,
+      context,
+      options: providerOptions,
+    });
+    if (!prepared || typeof prepared !== "object" || typeof prepared.transport !== "function") {
+      throw new ProviderRunSafetyContractError(
+        "Provider run-safety V1 preparation must return one finalPayload/transport descriptor.",
+      );
+    }
+    const replacement = await onPayload(prepared.finalPayload, model);
+    return await prepared.transport({
+      finalPayload: replacement ?? prepared.finalPayload,
+      model,
+      context,
+      options: providerOptions,
+    });
+  };
+  return markProviderRunSafetyStreamFnV1(streamFn);
+}
+
+/**
+ * Host-private compatibility bridge for bundled, audited provider transports
+ * that build their final payload internally and synchronously await
+ * `options.onPayload` immediately before their only real transport dispatch.
+ *
+ * Callers must establish bundled provenance from the host registry. This is
+ * deliberately not exported through the plugin SDK.
+ */
+export function adaptBundledAuditedProviderPayloadHookStreamFnV1(underlying: StreamFn): StreamFn {
+  const streamFn: StreamFn = (model, context, options) => {
+    assertHostRunSafetyDispatchContext(options);
+    return underlying(model, context, options);
+  };
+  return markProviderRunSafetyStreamFnV1(streamFn, underlying);
+}
+
+export function isProviderRunSafetyStreamFnV1(streamFn: StreamFn): boolean {
+  return providerRunSafetyStreamFnsV1.has(streamFn);
+}
+
+export function unwrapProviderRunSafetyStreamFnV1(streamFn: StreamFn): StreamFn {
+  return providerRunSafetyUnderlyingStreamFnsV1.get(streamFn) ?? streamFn;
+}
