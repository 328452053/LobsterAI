+    const rootInvocationId = params.rootInvocationId ?? this.createId();
+    const budgetScopeId = params.budgetScopeId ?? this.createId();
+
+    if (
+      this.activeScopes.has(budgetScopeId) ||
+      this.tombstones.has(budgetScopeId) ||
+      this.activeScopes.size >= this.maxActiveScopes
+    ) {
+      return this.stateUnavailable(rootInvocationId, budgetScopeId, params.rootRunId);
+    }
+
+    const coordinator = new RunSafetyRootCoordinator(rootInvocationId, params.onOrphanedTerminal);
+    const controller = new RunSafetyController({
+      rootInvocationId,
+      budgetScopeId,
+      rootRunId: params.rootRunId,
+      limits: params.limits,
+      variantWarningThreshold: params.variantWarningThreshold,
+      variantCriticalThreshold: params.variantCriticalThreshold,
+      onDrained: (reason) => {
