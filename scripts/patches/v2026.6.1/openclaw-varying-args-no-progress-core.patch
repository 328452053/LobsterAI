+  const details = {
+    rootInvocationId,
+    runId,
+    ...(detector.value ? { detector: detector.value } : {}),
+    ...(toolName.value ? { toolName: toolName.value } : {}),
+    ...(observedCount.value !== undefined ? { observedCount: observedCount.value } : {}),
+    ...(limit.value !== undefined ? { limit: limit.value } : {}),
+    ...(toolCallReservationCount.value !== undefined
+      ? { toolCallReservationCount: toolCallReservationCount.value }
+      : {}),
+    ...(providerDispatchCount.value !== undefined
+      ? { providerDispatchCount: providerDispatchCount.value }
+      : {}),
+    ...(cumulativeEstimatedPromptTokens.value !== undefined
+      ? { cumulativeEstimatedPromptTokens: cumulativeEstimatedPromptTokens.value }
+      : {}),
+  };
+  if (kind === RunSafetyTerminationKind.RunBudgetIdentityMissing) {
+    return record.budgetScopeId === undefined ? { ...details, kind } : undefined;
+  }
+  const budgetScopeId = readBoundedString(record.budgetScopeId, RUN_SAFETY_OPAQUE_ID_MAX_LENGTH);
+  if (!budgetScopeId) {
+    return undefined;
+  }
+  return {
+    ...details,
+    kind,
+    budgetScopeId,
+  };
+}
+
+export function createRunSafetyIdentityMissingTermination(params: {
+  rootInvocationId?: string;
+  runId: string;
+}): RunSafetyTermination {
+  return {
+    kind: RunSafetyTerminationKind.RunBudgetIdentityMissing,
+    rootInvocationId: isNonEmptyString(params.rootInvocationId)
+      ? params.rootInvocationId
+      : randomUUID(),
+    runId: params.runId,
+  };
+}
+
+export function createRunSafetyStateUnavailableTermination(params: {
+  rootInvocationId: string;
+  budgetScopeId: string;
+  runId: string;
+}): RunSafetyTermination {
+  return {
+    kind: RunSafetyTerminationKind.RunSafetyStateUnavailable,
+    rootInvocationId: params.rootInvocationId,
+    budgetScopeId: params.budgetScopeId,
+    runId: params.runId,
+  };
+}
+
+export class RunSafetyRegistry {
+  private readonly maxActiveScopes: number;
+  private readonly maxTombstones: number;
+  private readonly tombstoneTtlMs: number;
