+      toolName: "exec",
+      argsHash: "args:first-100",
+      familyHash: "family:read-only-window",
+      resultHash: "result:full",
+    });
+    const warning = controller.recordToolOutcome({
+      runId: "run-1",
+      toolName: "exec",
+      argsHash: "args:first-100",
+      familyHash: "family:read-only-window",
+      resultHash: "result:full",
+    });
+    const critical = controller.recordToolOutcome({
