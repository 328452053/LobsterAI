+import { describe, expect, it, vi } from "vitest";
+import { runWithRunSafetyProviderDispatch } from "../llm/run-safety-provider-dispatch-context.js";
+import { createAssistantMessageEventStream } from "../llm/utils/event-stream.js";
+import {
+  createProviderRunSafetyStreamFnV1,
+  ProviderRunSafetyContractError,
+} from "./provider-run-safety-contract.js";
+
+const model = {
+  api: "test-custom-api",
+  provider: "custom",
+  id: "model-1",
+  contextWindow: 128_000,
+} as never;
+const context = { messages: [] } as never;
+
+describe("provider run-safety V1 contract", () => {
+  it("awaits the host final-payload gate before the plugin transport can start", async () => {
+    const order: string[] = [];
+    const eventStream = createAssistantMessageEventStream();
+    const streamFn = createProviderRunSafetyStreamFnV1(async ({ options }) => ({
+      finalPayload: { input: ["original"] },
+      transport: ({ finalPayload, options: transportOptions }) => {
+        expect(options?.onPayload).toBeUndefined();
+        expect(transportOptions?.onPayload).toBeUndefined();
+        order.push(`transport:${JSON.stringify(finalPayload)}`);
+        return eventStream;
+      },
+    }));
+
+    const result = await runWithRunSafetyProviderDispatch(
+      async () =>
+        await streamFn(model, context, {
+          onPayload: async () => {
+            order.push("host-gate");
+            return { input: ["replacement"] };
+          },
+        }),
+    );
+
+    expect(result).toBe(eventStream);
+    expect(order).toEqual(["host-gate", 'transport:{"input":["replacement"]}']);
+  });
+
+  it("rejects before invoking plugin code outside the host dispatch scope", async () => {
+    const prepare = vi.fn(() => ({
+      finalPayload: {},
+      transport: () => createAssistantMessageEventStream(),
+    }));
+    const streamFn = createProviderRunSafetyStreamFnV1(prepare);
+
+    await expect(
+      streamFn(model, context, {
+        onPayload: vi.fn(),
+      }),
+    ).rejects.toBeInstanceOf(ProviderRunSafetyContractError);
+    expect(prepare).not.toHaveBeenCalled();
+  });
+
+  it("invokes the one prepared transport exactly once", async () => {
+    const transport = vi.fn(() => createAssistantMessageEventStream());
+    const streamFn = createProviderRunSafetyStreamFnV1(async () => ({
+      finalPayload: { input: ["one"] },
+      transport,
+    }));
+
+    await runWithRunSafetyProviderDispatch(
+      async () =>
+        await streamFn(model, context, {
+          onPayload: vi.fn(),
+        }),
+    );
+    expect(transport).toHaveBeenCalledTimes(1);
+  });
+
+  it("rejects malformed preparation before any transport can start", async () => {
+    const streamFn = createProviderRunSafetyStreamFnV1(async () => null as never);
+
+    await expect(
+      runWithRunSafetyProviderDispatch(
+        async () =>
+          await streamFn(model, context, {
+            onPayload: vi.fn(),
+          }),
+      ),
+    ).rejects.toBeInstanceOf(ProviderRunSafetyContractError);
+  });
+});
