+export type RunSafetyInheritedClaimIdentity = RunSafetyScopeIdentity & {
+  claimToken: string;
+};
+
+export type RunSafetyScopeTombstone = {
+  rootInvocationId: string;
+  budgetScopeId: string;
+  kind: RunSafetyScopeEndKind;
+  endedAt: number;
+};
+
+export type RunSafetyRegistryFailure = {
+  ok: false;
+  reason: RunSafetyTermination;
