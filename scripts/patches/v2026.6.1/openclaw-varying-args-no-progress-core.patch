+});
+
+describe("run safety prompt estimator", () => {
+  it("uses CJK-aware chars-per-token estimation plus structural overhead", () => {
+    const estimate = estimateRunSafetyPromptTokens({
+      systemPrompt: "系统",
+      messages: [{ role: "user", content: "hello" }],
+      tools: [{ name: "read" }],
+    });
+
+    expect(estimate.ok).toBe(true);
+    if (estimate.ok) {
+      expect(estimate.source).toBe("stable_text_tokens");
+      expect(estimate.estimatedPromptTokens).toBeGreaterThan(64 + 8 + 32);
+    }
+  });
+
+  it("estimates tokens, not bytes, so legacy telemetry keeps its calibration", () => {
+    // ~400K real tokens of ASCII ≈ 1.6MB serialized. The old byte-based
+    // formula estimated ~1.6M units for a 400K context; the legacy telemetry
+    // estimate should stay in the ~400K range for longitudinal comparability.
+    const asciiText = "word ".repeat(320_000);
+    const estimate = estimateRunSafetyPromptTokens({
+      messages: [{ role: "user", content: asciiText }],
+    });
+
+    expect(estimate.ok).toBe(true);
+    if (estimate.ok) {
+      expect(estimate.estimatedPromptTokens).toBeGreaterThan(300_000);
+      expect(estimate.estimatedPromptTokens).toBeLessThan(600_000);
+    }
+  });
+
+  it("weights CJK content fairly instead of tripling it through UTF-8 bytes", () => {
+    const cjk = estimateRunSafetyPromptTokens({
+      messages: [{ role: "user", content: "汉".repeat(10_000) }],
+    });
+    const latinEquivalent = estimateRunSafetyPromptTokens({
+      messages: [{ role: "user", content: "a".repeat(40_000) }],
+    });
+
+    expect(cjk.ok).toBe(true);
+    expect(latinEquivalent.ok).toBe(true);
+    if (cjk.ok && latinEquivalent.ok) {
+      // ~10K CJK chars ≈ ~10K tokens ≈ 40K Latin chars. Byte counting would
+      // have scored the CJK payload 3x the Latin one for the same real cost.
+      const ratio = cjk.estimatedPromptTokens / latinEquivalent.estimatedPromptTokens;
+      expect(ratio).toBeGreaterThan(0.8);
+      expect(ratio).toBeLessThan(1.3);
+    }
+  });
+
+  it("caps inline base64 media at a fixed conservative estimate", () => {
+    // ~1.4MB of inline base64 image data. Counting raw base64 length would
+    // add ~350K legacy units for a single image; the conservative per-blob
+    // constant keeps telemetry bounded while remaining well above real
+    // provider image billing.
+    const inlineImage = "A".repeat(1_400_000);
+    const estimate = estimateRunSafetyPromptTokens({
+      messages: [
+        {
+          role: "user",
+          content: [
+            { type: "text", text: "describe this image" },
+            { type: "image", source: { type: "base64", data: inlineImage } },
+          ],
+        },
+      ],
+    });
+
+    expect(estimate.ok).toBe(true);
+    if (estimate.ok) {
+      expect(estimate.source).toBe("stable_text_tokens");
+      expect(estimate.estimatedPromptTokens).toBeGreaterThanOrEqual(8_192);
+      expect(estimate.estimatedPromptTokens).toBeLessThan(20_000);
+    }
+  });
+
+  it("uses the context window as a floor for unknown remote media", () => {
+    const estimate = estimateRunSafetyPromptTokens(
+      {
+        messages: [{ role: "user", content: [{ type: "image_url", url: "https://x.test/a" }] }],
+      },
+      { contextWindow: 4096 },
+    );
+
+    expect(estimate).toEqual({
+      ok: true,
+      estimatedPromptTokens: 4096,
+      source: "context_window_floor",
+    });
+  });
+
+  it("reports estimate unavailable for unknown media without a context window", () => {
+    expect(
+      estimateRunSafetyPromptTokens({
+        messages: [{ role: "user", content: [{ type: "image_url", url: "https://x.test/a" }] }],
+      }),
+    ).toEqual({ ok: false, reason: "unknown_media_without_context_window" });
+  });
+
+  it("detects nested OpenAI image_url payloads as unknown remote media", () => {
+    const payload = {
+      messages: [
+        {
+          role: "user",
+          content: [
+            {
+              type: "image_url",
+              image_url: { url: "https://x.test/nested.png" },
+            },
+          ],
+        },
+      ],
+    };
+
+    expect(estimateRunSafetyPromptTokens(payload)).toEqual({
+      ok: false,
+      reason: "unknown_media_without_context_window",
+    });
+    expect(estimateRunSafetyPromptTokens(payload, { contextWindow: 8192 })).toEqual({
+      ok: true,
+      estimatedPromptTokens: 8192,
+      source: "context_window_floor",
+    });
+  });
+});
+
+describe("RunSafetyRootCoordinator", () => {
+  it("publishes only the first product terminal outcome", () => {
+    const coordinator = new RunSafetyRootCoordinator("root-1");
+    const first = {
+      kind: RunSafetyTerminationKind.RunToolBudget,
+      rootInvocationId: "root-1",
+      budgetScopeId: "scope-1",
+      runId: "run-1",
+    };
+    const second = {
+      ...first,
+      kind: RunSafetyTerminationKind.RunProviderDispatchBudget,
