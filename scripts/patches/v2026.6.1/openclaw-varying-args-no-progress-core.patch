+  }
+
+  /** Test-only process-local cleanup; production scopes must end via release/finalize. */
+  resetForTests(): void {
+    this.activeScopes.clear();
+    this.tombstones.clear();
+  }
+
+  private findMatchingActiveScope(context: RunSafetyContext): ActiveScope | undefined {
+    const entry = this.activeScopes.get(context.controller.budgetScopeId);
