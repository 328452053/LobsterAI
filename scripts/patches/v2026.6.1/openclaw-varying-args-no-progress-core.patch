diff --git a/src/agents/agent-tools.before-tool-call.variant-no-progress.test.ts b/src/agents/agent-tools.before-tool-call.variant-no-progress.test.ts
new file mode 100644
index 000000000..d6e1d0f2f
--- /dev/null
+++ b/src/agents/agent-tools.before-tool-call.variant-no-progress.test.ts
@@ -0,0 +1,116 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { diagnosticSessionStates } from "../logging/diagnostic-session-state.js";
+import {
+  type ToolOutcomeObservation,
+  wrapToolWithBeforeToolCallHook,
+} from "./agent-tools.before-tool-call.js";
+import { beforeToolCallRuntime } from "./agent-tools.before-tool-call.runtime.js";
+
+const sessionKey = "variant-no-progress-observer-test";
+
+function createPowerShellWindowParams(windowSize: number) {
+  return {
+    command:
+      'Get-ChildItem -Path "C:\\project\\artifacts" -Name | ' +
+      "Sort-Object LastWriteTime -Descending | " +
+      `Select-Object -First ${windowSize}`,
+  };
+}
+
+const stableResult = {
+  content: [{ type: "text", text: "report-a.md\nreport-b.md" }],
+  details: {
+    status: "completed",
+    exitCode: 0,
+    timedOut: false,
+    aggregated: "report-a.md\nreport-b.md",
+  },
+};
+
+describe("before-tool outcome variant no-progress observation", () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+    diagnosticSessionStates.delete(sessionKey);
+  });
+
+  it("publishes warning and critical signals immediately after the matching outcomes", async () => {
+    const observations: ToolOutcomeObservation[] = [];
+    const wrapped = wrapToolWithBeforeToolCallHook(
+      {
+        name: "exec",
+        execute: vi.fn(async () => stableResult),
+      } as never,
+      {
+        sessionKey,
+        sessionId: "session-variant",
+        runId: "run-variant",
+        loopDetection: {
+          enabled: true,
+          variantWarningThreshold: 2,
+          variantCriticalThreshold: 3,
+          detectors: { variantNoProgress: true },
+        },
+        onToolOutcome: (observation) => observations.push(observation),
+      },
+      { emitDiagnostics: false },
+    );
+
+    for (const [index, windowSize] of [80, 100, 120].entries()) {
+      await wrapped.execute(
+        `variant-call-${index}`,
+        createPowerShellWindowParams(windowSize),
+        undefined,
+        undefined,
+      );
+    }
+
+    expect(observations).toHaveLength(3);
+    expect(observations.every((observation) => Boolean(observation.familyHash))).toBe(true);
+    expect(observations[0]?.loopDetection).toBeUndefined();
+    expect(observations[1]?.loopDetection).toMatchObject({
+      level: "warning",
+      detector: "variant_no_progress",
+      count: 2,
+    });
+    expect(observations[2]?.loopDetection).toMatchObject({
+      level: "critical",
+      detector: "variant_no_progress",
+      count: 3,
+    });
+  });
+
+  it("notifies the hard-safety observer before diagnostic recording fails", async () => {
+    const observations: ToolOutcomeObservation[] = [];
+    vi.spyOn(beforeToolCallRuntime, "recordToolCallOutcome").mockImplementation(() => {
+      throw new Error("diagnostic storage unavailable");
+    });
+    const wrapped = wrapToolWithBeforeToolCallHook(
+      {
+        name: "exec",
+        execute: vi.fn(async () => stableResult),
+      } as never,
+      {
+        sessionKey,
+        sessionId: "session-diagnostic-failure",
+        runId: "run-diagnostic-failure",
+        onToolOutcome: (observation) => observations.push(observation),
+      },
+      { emitDiagnostics: false },
+    );
+
+    await wrapped.execute(
+      "diagnostic-failure-call",
+      createPowerShellWindowParams(80),
+      undefined,
+      undefined,
+    );
+
+    expect(observations).toHaveLength(1);
+    expect(observations[0]).toMatchObject({
+      toolName: "exec",
+      argsHash: expect.any(String),
+      familyHash: expect.any(String),
+      resultHash: expect.any(String),
+    });
+  });
+});
