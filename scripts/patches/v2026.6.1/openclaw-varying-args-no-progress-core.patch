+type ActiveRun = {
+  kind: "root" | RunSafetyInheritedRunKind;
+  claimToken?: string;
+};
+
+type InheritedClaim = {
+  claimToken: string;
+  kind: RunSafetyInheritedRunKind;
+  childSessionKey: string;
+  provisionalRunId: string;
+  parentRunId: string;
+  consumed: boolean;
+};
+
+type ActiveScope = {
+  context: RunSafetyContext;
+  identity: RunSafetyScopeIdentity;
+  rootRunId: string;
+  activeRuns: Map<string, ActiveRun>;
+  claims: Map<string, InheritedClaim>;
