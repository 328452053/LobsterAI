+  streamFn: StreamFn,
+  options?: { purpose?: ProviderStreamPurpose },
+): boolean {
+  const purpose = options?.purpose ?? ProviderStreamPurpose.Utility;
+  if (purpose === ProviderStreamPurpose.Agent && !isProviderRunSafetyStreamFnV1(streamFn)) {
+    throw new ProviderRunSafetyContractError(
+      `Custom API "${api}" cannot register an unversioned stream for Agent execution.`,
+    );
+  }
+
+  const existingProvider = getApiProvider(api);
+  let existingRegistration = customApiRegistrations.get(api);
+  if (!existingProvider) {
+    // The public registry can be reset independently in tests and lifecycle
+    // repair paths. Discard stale local bookkeeping with it.
+    customApiRegistrations.delete(api);
+    existingRegistration = undefined;
+  } else if (!existingRegistration) {
+    // Never replace a built-in or independently registered plugin provider.
+    return false;
+  }
+
+  if (purpose === ProviderStreamPurpose.Agent) {
+    if (existingRegistration?.agentStreamFn === streamFn) {
+      return false;
