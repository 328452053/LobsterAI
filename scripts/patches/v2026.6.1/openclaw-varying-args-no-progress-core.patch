diff --git a/src/plugins/provider-registration-provenance.ts b/src/plugins/provider-registration-provenance.ts
new file mode 100644
index 000000000..08d55d3b1
--- /dev/null
+++ b/src/plugins/provider-registration-provenance.ts
@@ -0,0 +1,28 @@
+import type { PluginOrigin } from "./plugin-origin.types.js";
+import type { PluginProviderRegistration, PluginRecord } from "./registry-types.js";
+import type { ProviderPlugin } from "./types.js";
+
+const providerHostOrigins = new WeakMap<ProviderPlugin, PluginOrigin>();
+
+/**
+ * Clone a provider registration for runtime use while retaining provenance in
+ * host-owned state. Provider fields such as `pluginId` are plugin-controlled
+ * and must never authorize the bundled compatibility bridge.
+ */
+export function cloneProviderPluginWithHostProvenance(params: {
+  registration: PluginProviderRegistration;
+  records: readonly PluginRecord[];
+}): ProviderPlugin {
+  const plugin = Object.assign({}, params.registration.provider, {
+    pluginId: params.registration.pluginId,
+  });
+  const record = params.records.find((candidate) => candidate.id === params.registration.pluginId);
+  if (record) {
+    providerHostOrigins.set(plugin, record.origin);
+  }
+  return plugin;
+}
+
+export function resolveProviderPluginHostOrigin(plugin: ProviderPlugin): PluginOrigin | undefined {
+  return providerHostOrigins.get(plugin);
+}
