+  }
+
+  get activeScopeCount(): number {
+    return this.activeScopes.size;
+  }
+
+  get tombstoneCount(): number {
+    this.pruneExpiredTombstones();
+    return this.tombstones.size;
+  }
+
+  hasActiveScope(budgetScopeId: string): boolean {
+    return this.activeScopes.has(budgetScopeId);
+  }
+
+  getTombstone(budgetScopeId: string): RunSafetyScopeTombstone | undefined {
+    this.pruneExpiredTombstones();
+    const tombstone = this.tombstones.get(budgetScopeId);
+    if (tombstone) {
+      // Map insertion order is the bounded LRU queue. A successful lookup
+      // refreshes recency without retaining any additional request data.
+      this.tombstones.delete(budgetScopeId);
+      this.tombstones.set(budgetScopeId, tombstone);
+    }
