diff --git a/src/agents/cli-runner/run-safety.ts b/src/agents/cli-runner/run-safety.ts
new file mode 100644
index 000000000..4c4410bfe
--- /dev/null
+++ b/src/agents/cli-runner/run-safety.ts
@@ -0,0 +1,191 @@
+import type { EmbeddedAgentRunResult } from "../embedded-agent-runner/types.js";
+import {
+  estimateRunSafetyPromptObservation,
+  type RunSafetyTermination,
+  RunSafetyTerminationKind,
+} from "../run-safety-controller.js";
+import type { PreparedCliRunContext, RunCliAgentParams } from "./types.js";
+
+const CLI_RUN_SAFETY_BLOCK_MESSAGE =
+  "CLI provider dispatch was blocked by the local run safety controller.";
+
+export class CliRunSafetyGateError extends Error {
+  constructor(readonly terminationReason: RunSafetyTermination) {
+    super(`${CLI_RUN_SAFETY_BLOCK_MESSAGE} (${terminationReason.kind})`);
+    this.name = "CliRunSafetyGateError";
+  }
+}
+
+export function isCliRunSafetyGateError(error: unknown): error is CliRunSafetyGateError {
+  return error instanceof CliRunSafetyGateError;
+}
+
+export type CliRunSafetyProviderReservation = {
+  providerDispatchId: string;
+  complete(): void;
+};
+
+/**
+ * Reserves one budget unit for one real CLI inference.
+ *
+ * The prompt is supplied after CLI input transforms and image materialization,
+ * immediately before the live-session turn or child-process spawn. Native CLI
+ * tool calls remain opaque to the host, so this gate intentionally covers only
+ * provider dispatch count and prompt observation, not raw tool reservations.
+ */
+export function reserveCliProviderDispatch(params: {
+  context: PreparedCliRunContext;
+  prompt: string;
+  systemPrompt?: string | null;
+  invocationArgs: readonly string[];
+  useResume: boolean;
+}): CliRunSafetyProviderReservation {
+  const runParams = params.context.params;
+  const runSafety = runParams.runSafety;
+  if (!runSafety) {
+    throw new CliRunSafetyGateError({
+      kind: RunSafetyTerminationKind.RunSafetyStateUnavailable,
+      rootInvocationId: runParams.runId,
+      runId: runParams.runId,
+    });
+  }
+
+  const providerDispatchId = runSafety.controller.createProviderDispatchId(runParams.runId);
+  const reservation = runSafety.controller.reserveProviderDispatch({
+    runId: runParams.runId,
+    providerDispatchId,
+  });
+  if (!reservation.allowed) {
+    const reason =
+      reservation.reason ??
+      runSafety.controller.tryTerminate({
+        kind: RunSafetyTerminationKind.RunSafetyStateUnavailable,
+        runId: runParams.runId,
+      });
+    runSafety.coordinator.publishTerminalOnce(reason);
+    throw new CliRunSafetyGateError(reason);
+  }
+
+  const observation = estimateRunSafetyPromptObservation(
+    {
+      harness: "cli",
+      provider: runParams.provider,
+      model: params.context.modelId,
+      mode: params.useResume ? "resume" : "fresh",
+      systemPrompt: params.systemPrompt ?? "",
+      prompt: params.prompt,
+      images: runParams.images ?? [],
+      invocationArgs: params.invocationArgs,
+    },
+    params.context.contextWindowInfo?.tokens
+      ? { contextWindow: params.context.contextWindowInfo.tokens }
+      : undefined,
+  );
+  runSafety.controller.observeProviderPromptEstimate({
+    providerDispatchId,
+    observation,
+  });
+
+  let completed = false;
+  return {
+    providerDispatchId,
+    complete() {
+      if (completed) {
+        return;
+      }
+      completed = true;
+      runSafety.controller.completeProviderDispatch(providerDispatchId);
+    },
+  };
+}
+
+export function buildCliRunSafetyBlockedResult(params: {
+  context: PreparedCliRunContext;
+  terminationReason: RunSafetyTermination;
+}): EmbeddedAgentRunResult {
+  const { context, terminationReason } = params;
+  const runParams = context.params;
+  return {
+    payloads: [{ text: CLI_RUN_SAFETY_BLOCK_MESSAGE, isError: true }],
+    meta: {
+      durationMs: Date.now() - context.started,
+      finalAssistantVisibleText: CLI_RUN_SAFETY_BLOCK_MESSAGE,
+      finalAssistantRawText: CLI_RUN_SAFETY_BLOCK_MESSAGE,
+      livenessState: "blocked",
+      stopReason: "run_safety",
+      terminationReason,
+      systemPromptReport: context.systemPromptReport,
+      executionTrace: {
+        winnerProvider: runParams.provider,
+        winnerModel: context.modelId,
+        attempts: [
+          {
+            provider: runParams.provider,
+            model: context.modelId,
+            result: "error",
+            reason: terminationReason.kind,
+          },
+        ],
+        fallbackUsed: false,
+        runner: "cli",
+      },
+      requestShaping: {
+        ...(runParams.thinkLevel ? { thinking: runParams.thinkLevel } : {}),
+        ...(context.effectiveAuthProfileId ? { authMode: "auth-profile" } : {}),
+      },
+      completion: {
+        finishReason: "blocked",
+        stopReason: "run_safety",
+        refusal: true,
+      },
+      agentMeta: {
+        sessionId: runParams.sessionId,
+        provider: runParams.provider,
+        model: context.modelId,
+      },
+    },
+  };
+}
+
+export function buildCliRunSafetyRegistrationBlockedResult(params: {
+  runParams: RunCliAgentParams;
+  terminationReason: RunSafetyTermination;
+}): EmbeddedAgentRunResult {
+  const { runParams, terminationReason } = params;
+  const model = runParams.model?.trim() || "default";
+  return {
+    payloads: [{ text: CLI_RUN_SAFETY_BLOCK_MESSAGE, isError: true }],
+    meta: {
+      durationMs: 0,
+      finalAssistantVisibleText: CLI_RUN_SAFETY_BLOCK_MESSAGE,
+      finalAssistantRawText: CLI_RUN_SAFETY_BLOCK_MESSAGE,
+      livenessState: "blocked",
+      stopReason: "run_safety",
+      terminationReason,
+      executionTrace: {
+        winnerProvider: runParams.provider,
+        winnerModel: model,
+        attempts: [
+          {
+            provider: runParams.provider,
+            model,
+            result: "error",
+            reason: terminationReason.kind,
+          },
+        ],
+        fallbackUsed: false,
+        runner: "cli",
+      },
+      completion: {
+        finishReason: "blocked",
+        stopReason: "run_safety",
+        refusal: true,
+      },
+      agentMeta: {
+        sessionId: runParams.sessionId,
+        provider: runParams.provider,
+        model,
+      },
+    },
+  };
+}
