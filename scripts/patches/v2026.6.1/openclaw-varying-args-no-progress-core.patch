+
+type ToolReservation = {
+  decision: RunSafetyToolReservationDecision;
+  completed: boolean;
+};
+
+type ProviderReservation = {
+  decision: RunSafetyProviderReservationDecision;
+  observation: PromptObservationState;
+  completed: boolean;
+};
+
+type RunDetectorState = {
+  history: RunSafetyToolOutcomeObservation[];
+  variantWarningEmitted: boolean;
+};
+
+function isPositiveSafeInteger(value: unknown): value is number {
+  return (
+    typeof value === "number" && Number.isSafeInteger(value) && Number.isFinite(value) && value > 0
+  );
+}
+
+function isWarningRatio(value: unknown): value is number {
+  return typeof value === "number" && Number.isFinite(value) && value > 0 && value < 1;
+}
+
+export function resolveRunSafetyBudgetLimits(
+  value?: RunSafetyControllerLimits,
+): RunSafetyBudgetLimits {
+  return {
+    maxToolCallReservationsPerBudgetScope: isPositiveSafeInteger(
+      value?.maxToolCallReservationsPerBudgetScope,
+    )
+      ? value.maxToolCallReservationsPerBudgetScope
+      : RunSafetyBudgetDefaults.maxToolCallReservationsPerBudgetScope,
+    maxProviderDispatchesPerBudgetScope: isPositiveSafeInteger(
+      value?.maxProviderDispatchesPerBudgetScope,
+    )
+      ? value.maxProviderDispatchesPerBudgetScope
+      : RunSafetyBudgetDefaults.maxProviderDispatchesPerBudgetScope,
+    warningRatio: isWarningRatio(value?.warningRatio)
+      ? value.warningRatio
+      : RunSafetyBudgetDefaults.warningRatio,
+  };
+}
+
+export function resolveRunSafetyPromptExposureConfig(
+  value?: RunSafetyControllerLimits["promptExposure"],
+): RunSafetyPromptExposureConfig {
+  return {
+    mode: RunSafetyPromptExposureDefaults.mode,
+    legacyDiagnosticThreshold: isPositiveSafeInteger(value?.legacyDiagnosticThreshold)
+      ? value.legacyDiagnosticThreshold
+      : RunSafetyPromptExposureDefaults.legacyDiagnosticThreshold,
+  };
+}
+
+function normalizePromptEstimate(value: unknown): number | undefined {
+  if (typeof value !== "number" || !Number.isFinite(value) || value < 0) {
+    return undefined;
+  }
+  const normalized = Math.max(1, Math.ceil(value));
+  return Number.isSafeInteger(normalized) ? normalized : undefined;
+}
+
+function saturatingAdd(left: number, right: number): number {
+  if (!Number.isSafeInteger(left) || !Number.isSafeInteger(right) || left < 0 || right < 0) {
+    return Number.MAX_SAFE_INTEGER;
+  }
+  if (left > Number.MAX_SAFE_INTEGER - right) {
+    return Number.MAX_SAFE_INTEGER;
+  }
+  return left + right;
+}
+
+function countPayloadItems(payload: unknown): {
+  messageCount: number;
+  toolDefinitionCount: number;
+} {
+  if (!payload || typeof payload !== "object") {
+    return { messageCount: 0, toolDefinitionCount: 0 };
+  }
+  const record = payload as Record<string, unknown>;
+  const messages = Array.isArray(record.messages)
+    ? record.messages
+    : Array.isArray(record.input)
+      ? record.input
+      : Array.isArray(record.contents)
+        ? record.contents
+        : [];
+  const tools = Array.isArray(record.tools)
+    ? record.tools
+    : Array.isArray(record.toolDefinitions)
+      ? record.toolDefinitions
+      : [];
+  return {
+    messageCount: messages.length,
+    toolDefinitionCount: tools.length,
+  };
+}
+
+function containsUnknownRemoteMedia(value: unknown, seen = new Set<object>()): boolean {
+  if (!value || typeof value !== "object") {
+    return false;
+  }
+  if (seen.has(value)) {
+    return false;
+  }
+  seen.add(value);
+  if (Array.isArray(value)) {
+    return value.some((entry) => containsUnknownRemoteMedia(entry, seen));
+  }
+  const record = value as Record<string, unknown>;
+  const type = typeof record.type === "string" ? record.type.toLowerCase() : "";
+  const mediaType =
+    type.includes("image") || type.includes("audio") || type.includes("video") || type === "media";
+  if (mediaType) {
+    const imageUrl =
+      record.image_url && typeof record.image_url === "object"
+        ? (record.image_url as Record<string, unknown>)
+        : undefined;
+    const fileUrl =
+      record.file_url && typeof record.file_url === "object"
+        ? (record.file_url as Record<string, unknown>)
+        : undefined;
+    const source =
+      record.source && typeof record.source === "object"
+        ? (record.source as Record<string, unknown>)
+        : undefined;
+    const remote =
+      typeof record.url === "string" ||
+      typeof record.image_url === "string" ||
+      typeof record.file_url === "string" ||
+      typeof imageUrl?.url === "string" ||
+      typeof fileUrl?.url === "string" ||
+      (source?.type === "url" && typeof source.url === "string");
+    const inline =
+      typeof record.data === "string" ||
+      typeof record.source === "string" ||
+      typeof record.bytes === "string" ||
+      typeof source?.data === "string" ||
+      typeof source?.bytes === "string";
+    if (remote && !inline) {
+      return true;
+    }
+  }
+  return Object.values(record).some((entry) => containsUnknownRemoteMedia(entry, seen));
+}
+
+export type PromptEstimateResult =
+  | {
+      ok: true;
+      estimatedPromptTokens: number;
+      source: PromptEstimateSource;
+    }
+  | {
+      ok: false;
+      reason:
+        | typeof PromptEstimateUnavailableReason.SerializationFailed
+        | typeof PromptEstimateUnavailableReason.UnknownMediaWithoutContextWindow;
+    };
+
+/**
+ * Contiguous base64-looking runs of at least this many characters inside the
+ * serialized payload are treated as inline media/binary blobs. Natural text
+ * and code contain whitespace or punctuation long before this length, so the
+ * false-positive surface is limited to large hex/base64 dumps, which the
+ * conservative per-blob estimate still bounds safely.
+ */
+const INLINE_MEDIA_BASE64_RUN_RE = /[A-Za-z0-9+/]{4096,}={0,2}/g;
+/**
+ * Conservative per-blob prompt token estimate for inline media. Provider
+ * image billing typically lands far below this; counting the raw base64
+ * length instead would overstate one image by two orders of magnitude and
+ * distort legacy telemetry comparability.
+ */
+const INLINE_MEDIA_TOKEN_ESTIMATE = 8_192;
+
+export function estimateRunSafetyPromptTokens(
+  payload: unknown,
+  model?: Pick<Model, "contextWindow">,
+): PromptEstimateResult {
+  let serialized: string;
+  try {
+    serialized = stableStringify(payload);
+  } catch {
+    return { ok: false, reason: PromptEstimateUnavailableReason.SerializationFailed };
+  }
+  if (typeof serialized !== "string") {
+    return { ok: false, reason: PromptEstimateUnavailableReason.SerializationFailed };
+  }
+  // CJK-aware chars-per-token estimate over the final serialized payload.
+  // Counting UTF-8 bytes here would overstate Latin text ~4x and CJK text
+  // ~2-3x, breaking legacy telemetry calibration across payload languages.
+  let textChars = estimateStringChars(serialized);
+  let inlineMediaTokens = 0;
+  for (const match of serialized.matchAll(INLINE_MEDIA_BASE64_RUN_RE)) {
+    // Base64 runs are pure ASCII, so each contributes exactly its length to
+    // the adjusted char count; swap that contribution for the media estimate.
+    textChars -= match[0].length;
+    inlineMediaTokens = saturatingAdd(inlineMediaTokens, INLINE_MEDIA_TOKEN_ESTIMATE);
+  }
+  const counts = countPayloadItems(payload);
+  const structuralOverhead = 64 + 8 * counts.messageCount + 32 * counts.toolDefinitionCount;
+  const textEstimate = saturatingAdd(
+    saturatingAdd(estimateTokensFromChars(Math.max(0, textChars)), structuralOverhead),
+    inlineMediaTokens,
+  );
+  if (!containsUnknownRemoteMedia(payload)) {
+    return {
+      ok: true,
+      estimatedPromptTokens: textEstimate,
+      source: PromptEstimateSource.StableTextTokens,
+    };
+  }
+  const contextWindow = normalizePromptEstimate(model?.contextWindow);
+  if (!contextWindow) {
+    return {
+      ok: false,
+      reason: PromptEstimateUnavailableReason.UnknownMediaWithoutContextWindow,
+    };
+  }
+  return {
+    ok: true,
+    estimatedPromptTokens: Math.max(textEstimate, contextWindow),
+    source: PromptEstimateSource.ContextWindowFloor,
+  };
+}
+
+export function estimateRunSafetyPromptObservation(
+  payload: unknown,
+  model?: Pick<Model, "contextWindow">,
+): FinalPromptObservation {
+  let estimate: PromptEstimateResult;
+  try {
+    estimate = estimateRunSafetyPromptTokens(payload, model);
+  } catch {
+    return {
+      status: PromptObservationStatus.Unavailable,
+      reason: PromptEstimateUnavailableReason.EstimatorThrew,
+    };
+  }
+  if (!estimate.ok) {
+    return {
+      status: PromptObservationStatus.Unavailable,
+      reason: estimate.reason,
+    };
+  }
+  const normalizedEstimate = normalizePromptEstimate(estimate.estimatedPromptTokens);
+  if (!normalizedEstimate) {
+    return {
+      status: PromptObservationStatus.Unavailable,
+      reason: PromptEstimateUnavailableReason.InvalidEstimate,
+    };
+  }
+  return {
+    status: PromptObservationStatus.Known,
+    legacyEstimatedExposureUnits: normalizedEstimate,
+    source: estimate.source,
+  };
+}
+
+export class RunSafetyRootCoordinator {
+  readonly rootInvocationId: string;
+  private published?: RunSafetyTermination;
+  private ownerPublishSucceeded = false;
+  private ownerPublishTask?: Promise<boolean>;
+  private readonly onOwnerTerminal?: (reason: RunSafetyTermination) => Promise<void> | void;
+
+  constructor(
+    rootInvocationId: string = randomUUID(),
+    onOwnerTerminal?: (reason: RunSafetyTermination) => Promise<void> | void,
+  ) {
+    this.rootInvocationId = rootInvocationId;
+    this.onOwnerTerminal = onOwnerTerminal;
+  }
+
+  publishTerminalOnce(reason: RunSafetyTermination): boolean {
+    if (this.published) {
+      return false;
+    }
+    this.published = reason;
+    return true;
+  }
+
+  publishTerminalToOwnerOnce(reason: RunSafetyTermination): Promise<boolean> {
+    this.publishTerminalOnce(reason);
+    if (this.ownerPublishSucceeded) {
+      return Promise.resolve(false);
+    }
+    if (this.ownerPublishTask) {
+      return this.ownerPublishTask;
+    }
+    const published = this.published ?? reason;
+    this.ownerPublishTask = (async () => {
+      if (!this.onOwnerTerminal) {
+        this.ownerPublishSucceeded = true;
+        return true;
+      }
+      // Product terminal publication is write-once. The retained delivery
+      // callback is retried only when it rejects, so a failed delivery attempt
+      // is never mistaken for a successful publication.
+      for (let attempt = 0; attempt < 3; attempt += 1) {
+        try {
+          await this.onOwnerTerminal(published);
+          this.ownerPublishSucceeded = true;
+          return true;
+        } catch {
+          // Retry below. Delivery owns its receipt and idempotency key.
+        }
+      }
+      return false;
+    })();
+    return this.ownerPublishTask;
+  }
+
+  get publishedTerminal(): RunSafetyTermination | undefined {
+    return this.published;
+  }
+}
+
+export class RunSafetyController {
+  readonly rootInvocationId: string;
+  readonly budgetScopeId: string;
+  readonly rootRunId: string;
+  readonly limits: Readonly<RunSafetyBudgetLimits>;
+  readonly promptExposure: Readonly<RunSafetyPromptExposureConfig>;
+  private statusValue: "active" | "draining" | "ended" = "active";
+  private toolCallReservationCountValue = 0;
+  private providerDispatchCountValue = 0;
+  private legacyEstimatedExposureUnitsTotalValue = 0;
+  private knownEstimateDispatchCountValue = 0;
+  private estimateUnavailableDispatchCountValue = 0;
+  private maxLegacyEstimatedExposureUnitsPerDispatchValue = 0;
+  private readonly estimateSourceCounts = new Map<PromptEstimateSource, number>();
+  private readonly unavailableReasonCounts = new Map<PromptEstimateUnavailableReason, number>();
+  private legacyDiagnosticThresholdCrossedValue = false;
+  private promptUnavailableDiagnosticEmitted = false;
+  private scopeSummaryEmitted = false;
+  private continuationClosedReasonValue?: RunSafetyTerminationKind;
+  private scopeTerminalReasonValue?: RunSafetyTermination;
+  private toolBatchSequence = 0;
+  private providerDispatchSequence = 0;
+  private readonly toolReservations = new Map<string, ToolReservation>();
+  private readonly providerReservations = new Map<string, ProviderReservation>();
+  private readonly runDetectorStates = new Map<string, RunDetectorState>();
+  private readonly variantWarningThreshold: number;
+  private readonly variantCriticalThreshold: number;
+  private readonly warnings = new Map<RunSafetyWarningDimension, RunSafetyWarning>();
+  private readonly onTelemetry: (record: RunSafetyTelemetryRecord) => void;
+  private onDrained?: (reason: RunSafetyTermination) => void;
+
+  constructor(params: {
+    rootInvocationId: string;
+    budgetScopeId?: string;
+    rootRunId: string;
+    limits?: RunSafetyControllerLimits;
+    variantWarningThreshold?: number;
+    variantCriticalThreshold?: number;
+    onDrained?: (reason: RunSafetyTermination) => void;
+    onTelemetry?: (record: RunSafetyTelemetryRecord) => void;
+  }) {
+    this.rootInvocationId = params.rootInvocationId;
+    this.budgetScopeId = params.budgetScopeId ?? randomUUID();
+    this.rootRunId = params.rootRunId;
