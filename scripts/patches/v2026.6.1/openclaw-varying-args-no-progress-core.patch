+      options.maxActiveScopes,
+      RunSafetyRegistryDefaults.maxActiveScopes,
+    );
+    this.maxTombstones = resolvePositiveInteger(
+      options.maxTombstones,
+      RunSafetyRegistryDefaults.maxTombstones,
+    );
+    this.tombstoneTtlMs = resolvePositiveInteger(
+      options.tombstoneTtlMs,
+      RunSafetyRegistryDefaults.tombstoneTtlMs,
+    );
+    this.now = options.now ?? Date.now;
+    this.createId = options.createId ?? randomUUID;
+  }
+
+  registerRoot(params: RegisterRootParams): RunSafetyRootRegistration {
