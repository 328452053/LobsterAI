+
+function registerRoot(
+  registry: RunSafetyRegistry,
+  index = 1,
+): Extract<ReturnType<RunSafetyRegistry["registerRoot"]>, { ok: true }> {
+  const result = registry.registerRoot({
+    rootInvocationId: `root-${index}`,
+    budgetScopeId: `scope-${index}`,
+    rootRunId: `run-${index}`,
+  });
+  if (!result.ok) {
+    throw new Error(`root registration failed: ${result.reason.kind}`);
+  }
+  return result;
+}
+
+function claimSubagent(
+  registry: RunSafetyRegistry,
+  root: ReturnType<typeof registerRoot>,
+  suffix = "child",
+): Extract<ReturnType<RunSafetyRegistry["claimSubagent"]>, { ok: true }> {
+  const result = registry.claimSubagent({
+    context: root.context,
+    parentRunId: root.context.controller.rootRunId,
+    childSessionKey: `session-${suffix}`,
+    provisionalRunId: `run-${suffix}`,
+  });
+  if (!result.ok) {
+    throw new Error(`subagent claim failed: ${result.reason.kind}`);
+  }
+  return result;
+}
