+    expect(registry.activeScopeCount).toBe(RunSafetyRegistryDefaults.maxActiveScopes);
+    for (let index = 0; index < RunSafetyRegistryDefaults.maxActiveScopes; index += 1) {
+      expect(registry.hasActiveScope(`scope-${index}`)).toBe(true);
+    }
+  });
+
+  it("atomically admits only one concurrent registration for the same scope", async () => {
