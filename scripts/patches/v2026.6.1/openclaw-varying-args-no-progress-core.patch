+    const onOrphanedTerminal = vi.fn(() => {
+      tombstonesObservedByOwner.push(registry.getTombstone("scope-1"));
+    });
+    const registration = registry.registerRoot({
+      rootInvocationId: "root-1",
+      budgetScopeId: "scope-1",
+      rootRunId: "run-1",
+      onOrphanedTerminal,
+    });
