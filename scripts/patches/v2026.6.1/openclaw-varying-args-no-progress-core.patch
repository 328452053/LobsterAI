+
+    expect(decisions.map((decision) => decision.allowed)).toEqual([true, false, false]);
+    expect(decisions[1]?.reason?.kind).toBe(RunSafetyTerminationKind.RunToolBudget);
+    expect(controller.snapshot().toolCallReservationCount).toBe(64);
