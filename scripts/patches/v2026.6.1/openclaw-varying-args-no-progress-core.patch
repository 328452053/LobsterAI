+  claimToken: string;
+};
+
+type ReleaseRunParams = {
+  context: RunSafetyContext;
+  runId: string;
+};
+
+function resolvePositiveInteger(value: number | undefined, fallback: number): number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value > 0 ? value : fallback;
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === "string" && value.length > 0;
+}
+
+const RUN_SAFETY_OPAQUE_ID_MAX_LENGTH = 256;
+const RUN_SAFETY_LABEL_MAX_LENGTH = 128;
+const RUN_SAFETY_TERMINATION_KINDS = new Set<string>(Object.values(RunSafetyTerminationKind));
+
+function readBoundedString(value: unknown, maxLength: number): string | undefined {
+  if (typeof value !== "string") {
+    return undefined;
+  }
+  const normalized = value.trim();
+  return normalized && normalized.length <= maxLength ? normalized : undefined;
+}
+
+function readOptionalBoundedString(
+  record: Record<string, unknown>,
+  key: string,
+  maxLength: number,
+): { valid: boolean; value?: string } {
+  if (!(key in record)) {
+    return { valid: true };
+  }
+  const value = readBoundedString(record[key], maxLength);
+  return value ? { valid: true, value } : { valid: false };
+}
+
+function readOptionalNonNegativeSafeInteger(
+  record: Record<string, unknown>,
+  key: string,
+): { valid: boolean; value?: number } {
+  if (!(key in record)) {
+    return { valid: true };
+  }
+  const value = record[key];
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0
+    ? { valid: true, value }
+    : { valid: false };
+}
+
+export function parseRunSafetyTermination(value: unknown): RunSafetyTermination | undefined {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    return undefined;
+  }
+  const record = value as Record<string, unknown>;
+  const rootInvocationId = readBoundedString(
+    record.rootInvocationId,
+    RUN_SAFETY_OPAQUE_ID_MAX_LENGTH,
+  );
+  const runId = readBoundedString(record.runId, RUN_SAFETY_OPAQUE_ID_MAX_LENGTH);
+  if (
+    !isNonEmptyString(record.kind) ||
+    !RUN_SAFETY_TERMINATION_KINDS.has(record.kind) ||
+    !rootInvocationId ||
+    !runId
+  ) {
+    return undefined;
+  }
+  const kind = record.kind as RunSafetyTerminationKind;
+  const detector = readOptionalBoundedString(record, "detector", RUN_SAFETY_LABEL_MAX_LENGTH);
+  const toolName = readOptionalBoundedString(record, "toolName", RUN_SAFETY_LABEL_MAX_LENGTH);
+  const observedCount = readOptionalNonNegativeSafeInteger(record, "observedCount");
+  const limit = readOptionalNonNegativeSafeInteger(record, "limit");
+  const toolCallReservationCount = readOptionalNonNegativeSafeInteger(
+    record,
+    "toolCallReservationCount",
+  );
+  const providerDispatchCount = readOptionalNonNegativeSafeInteger(record, "providerDispatchCount");
+  const cumulativeEstimatedPromptTokens = readOptionalNonNegativeSafeInteger(
+    record,
+    "cumulativeEstimatedPromptTokens",
+  );
