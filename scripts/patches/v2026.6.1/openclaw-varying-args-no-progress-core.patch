+      .mockRejectedValueOnce(new Error("temporary delivery failure"))
+      .mockResolvedValue(undefined);
+    const registration = registry.registerRoot({
+      rootInvocationId: "root-1",
+      budgetScopeId: "scope-1",
+      rootRunId: "run-1",
+      onOrphanedTerminal,
+      onDrained,
+    });
+    if (!registration.ok) {
+      throw new Error("expected root registration to succeed");
+    }
