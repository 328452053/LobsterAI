+    const familyHash = hashToolCallFamily(name, params);
+    if (!familyHash) {
+      return null;
+    }
+    toolCall = { id, name, params, familyHash };
+  }
+
+  return sawThinking ? (toolCall ?? null) : null;
+}
+
+function extractRepeatedToolHistoryPair(
+  messages: AgentMessage[],
+  start: number,
+): RepeatedToolHistoryPair | null {
+  const assistant = messages[start];
+  const toolResult = messages[start + 1];
+  if (!assistant || !toolResult || getMessageRole(toolResult) !== "toolResult") {
+    return null;
+  }
+  const toolCall = extractSingleReplayFamilyToolCall(assistant);
+  if (!toolCall) {
+    return null;
+  }
+
+  const result = toolResult as Extract<AgentMessage, { role: "toolResult" }>;
+  const resultIds = extractToolResultIds(result);
+  if (
+    resultIds.length !== 1 ||
+    resultIds[0] !== toolCall.id ||
+    result.toolName !== toolCall.name ||
+    typeof result.isError !== "boolean" ||
+    !Array.isArray(result.content) ||
+    result.content.some(
+      (block) =>
+        !block ||
+        typeof block !== "object" ||
+        (block as { type?: unknown }).type !== "text" ||
+        typeof (block as { text?: unknown }).text !== "string",
+    )
+  ) {
+    return null;
+  }
+
+  const resultHash = hashToolResultOutcome(toolCall.name, toolCall.params, {
+    content: result.content,
+    details: result.details,
+    isError: result.isError,
+  });
+  if (!resultHash) {
+    return null;
+  }
+  return {
+    start,
+    endExclusive: start + 2,
+    familyHash: toolCall.familyHash,
+    resultHash,
+  };
+}
+
+function collapseRepeatedToolHistoryPairs(messages: AgentMessage[]): AgentMessage[] {
+  const dropIndexes = new Set<number>();
+
+  for (let index = 0; index < messages.length; ) {
+    const first = extractRepeatedToolHistoryPair(messages, index);
+    if (!first) {
+      index += 1;
+      continue;
+    }
+
+    const pairs = [first];
+    let nextIndex = first.endExclusive;
+    while (nextIndex < messages.length) {
+      const next = extractRepeatedToolHistoryPair(messages, nextIndex);
+      if (!next || next.familyHash !== first.familyHash || next.resultHash !== first.resultHash) {
+        break;
+      }
+      pairs.push(next);
+      nextIndex = next.endExclusive;
+    }
+
+    if (pairs.length >= MIN_REPEATED_TOOL_HISTORY_PAIRS) {
+      const collapsed = pairs.slice(0, -MAX_PRESERVED_REPEATED_TOOL_HISTORY_PAIRS);
+      for (const pair of collapsed) {
+        for (let pairIndex = pair.start; pairIndex < pair.endExclusive; pairIndex += 1) {
+          dropIndexes.add(pairIndex);
+        }
+      }
+      log.debug(
+        `folded repeated tool history group: collapsedPairs=${collapsed.length} familyHash=${first.familyHash.slice(0, 12)} resultHash=${first.resultHash.slice(0, 12)}`,
+      );
+    }
+
+    index = nextIndex;
+  }
+
+  return dropIndexes.size === 0 ? messages : messages.filter((_, index) => !dropIndexes.has(index));
+}
