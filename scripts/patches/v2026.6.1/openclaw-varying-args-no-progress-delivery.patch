--- /dev/null
+++ b/src/agents/run-safety-delivery.ts
@@ -0,0 +1,269 @@
+import {
+  getReplyPayloadMetadata,
+  setReplyPayloadMetadata,
+  type ReplyPayload,
+} from "../auto-reply/reply-payload.js";
+import type { RunSafetyTermination, RunSafetyTerminationKind } from "./run-safety-controller.js";
+import { RunSafetyTerminationKind as TerminationKind } from "./run-safety-controller.js";
+
+export const RunSafetyDeliveryLocale = {
+  English: "en",
+  Chinese: "zh",
+} as const;
+
+export type RunSafetyDeliveryLocale =
+  (typeof RunSafetyDeliveryLocale)[keyof typeof RunSafetyDeliveryLocale];
+
+const RUN_SAFETY_DELIVERY_TEXT: Record<
+  RunSafetyDeliveryLocale,
+  Record<RunSafetyTerminationKind, string>
+> = {
+  [RunSafetyDeliveryLocale.Chinese]: {
+    [TerminationKind.VariantNoProgress]:
+      "检测到任务连续执行相似操作但没有获得新结果，已自动停止以避免继续产生无效的模型调用和费用。请补充说明后重试。",
+    [TerminationKind.RunToolBudget]:
+      "本次任务的工具调用次数已达到本地安全上限，已自动停止。请检查当前结果，并通过一条新指令继续。",
+    [TerminationKind.RunProviderDispatchBudget]:
+      "本次任务的模型请求次数已达到本地安全上限，已自动停止。请检查当前结果，并通过一条新指令继续。",
+    [TerminationKind.RunPromptExposureBudget]:
+      "本次任务的累计上下文暴露量已达到本地安全上限，已自动停止。请检查当前结果，并通过一条新指令继续。",
+    [TerminationKind.RunPromptEstimateUnavailable]:
+      "本地无法可靠估算本次请求的上下文暴露量，已在下一次模型请求前停止。请检查输入或模型配置后，通过一条新指令重试。",
+    [TerminationKind.RunBudgetIdentityMissing]:
+      "本地未能可靠建立本次任务的安全预算标识，已在调用模型前停止。请通过一条新指令重试。",
+    [TerminationKind.RunSafetyStateUnavailable]:
+      "本地安全状态暂时不可用，已在调用模型前停止。请稍后通过一条新指令重试。",
+  },
+  [RunSafetyDeliveryLocale.English]: {
+    [TerminationKind.VariantNoProgress]:
+      "The task repeatedly performed similar operations without producing a new result, so it was stopped to avoid further ineffective model calls and cost. Add more guidance and try again.",
+    [TerminationKind.RunToolBudget]:
+      "This task reached the local safety limit for tool calls and was stopped. Review the current result, then send a new instruction to continue.",
+    [TerminationKind.RunProviderDispatchBudget]:
+      "This task reached the local safety limit for model requests and was stopped. Review the current result, then send a new instruction to continue.",
+    [TerminationKind.RunPromptExposureBudget]:
+      "This task reached the local safety limit for cumulative context exposure and was stopped. Review the current result, then send a new instruction to continue.",
+    [TerminationKind.RunPromptEstimateUnavailable]:
+      "The local runtime could not reliably estimate this request's context exposure, so it stopped before the next model request. Check the input or model configuration, then retry with a new instruction.",
+    [TerminationKind.RunBudgetIdentityMissing]:
+      "The local runtime could not reliably establish this task's safety-budget identity, so it stopped before calling the model. Retry with a new instruction.",
+    [TerminationKind.RunSafetyStateUnavailable]:
+      "The local safety state is temporarily unavailable, so the task stopped before calling the model. Retry later with a new instruction.",
+  },
+};
+
+const CJK_CHARACTER_PATTERN =
+  /[\u2e80-\u2eff\u3000-\u303f\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]/u;
+
+export function resolveRunSafetyDeliveryLocale(text?: string): RunSafetyDeliveryLocale {
+  return text && CJK_CHARACTER_PATTERN.test(text)
+    ? RunSafetyDeliveryLocale.Chinese
+    : RunSafetyDeliveryLocale.English;
+}
+
+export function buildRunSafetyDeliveryKey(
+  termination: Pick<RunSafetyTermination, "rootInvocationId" | "kind">,
+): string {
+  return JSON.stringify([termination.rootInvocationId, termination.kind]);
+}
+
+export function buildRunSafetyReplyPayload(params: {
+  termination: RunSafetyTermination;
+  locale: RunSafetyDeliveryLocale;
+}): ReplyPayload {
+  return setReplyPayloadMetadata(
+    {
+      text: RUN_SAFETY_DELIVERY_TEXT[params.locale][params.termination.kind],
+    },
+    {
+      deliverDespiteSourceReplySuppression: true,
+      runSafetyDelivery: {
+        rootInvocationId: params.termination.rootInvocationId,
+        kind: params.termination.kind,
+      },
+    },
+  );
+}
+
+export function buildRunSafetyNativeReplyPayloads(params: {
+  termination?: RunSafetyTermination;
+  providerPayloads?: readonly ReplyPayload[];
+  sourceText?: string;
+}): ReplyPayload[] {
+  if (!params.termination) {
+    return [...(params.providerPayloads ?? [])];
+  }
+  if (hasRunSafetyDeliveryReceipt(params.termination)) {
+    return [];
+  }
+  const key = buildRunSafetyDeliveryKey(params.termination);
+  const existingAttempt = inFlightRunSafetyDeliveries.get(key);
+  if (existingAttempt) {
+    // A claim whose deadline elapsed can no longer be settled by its own send
+    // path (the payload identity may have been lost in a delivery transform).
+    // Fail it so the retained owner can re-claim instead of waiting forever.
+    if (Date.now() < existingAttempt.expiresAtMs) {
+      return [];
+    }
+    settleRunSafetyDeliveryAttempt(key, false);
+  }
+  let resolveAttempt!: (delivered: boolean) => void;
+  const promise = new Promise<boolean>((resolve) => {
+    resolveAttempt = resolve;
+  });
+  const expiryTimer = setTimeout(() => {
+    settleRunSafetyDeliveryAttempt(key, false);
+  }, runSafetyDeliveryClaimTimeoutMs);
+  expiryTimer.unref?.();
+  inFlightRunSafetyDeliveries.set(key, {
+    promise,
+    resolve: resolveAttempt,
+    expiresAtMs: Date.now() + runSafetyDeliveryClaimTimeoutMs,
+    expiryTimer,
+  });
+  return [
+    buildRunSafetyReplyPayload({
+      termination: params.termination,
+      locale: resolveRunSafetyDeliveryLocale(params.sourceText),
+    }),
+  ];
+}
+
+const deliveredRunSafetyKeys = new Set<string>();
+const inFlightRunSafetyDeliveries = new Map<
+  string,
+  {
+    promise: Promise<boolean>;
+    resolve: (delivered: boolean) => void;
+    expiresAtMs: number;
+    expiryTimer: ReturnType<typeof setTimeout>;
+  }
+>();
+const MAX_DELIVERED_RUN_SAFETY_KEYS = 512;
+/**
+ * An in-flight claim is only a lease. Delivery transforms may replace the
+ * payload object and lose the receipt identity, in which case the claimed
+ * attempt can never settle itself; the lease deadline converts that into an
+ * explicit failure so owner retries and scope finalization stay bounded.
+ */
+const DEFAULT_RUN_SAFETY_DELIVERY_CLAIM_TIMEOUT_MS = 30_000;
+let runSafetyDeliveryClaimTimeoutMs = DEFAULT_RUN_SAFETY_DELIVERY_CLAIM_TIMEOUT_MS;
+
+export function setRunSafetyDeliveryClaimTimeoutMsForTests(timeoutMs?: number): void {
+  runSafetyDeliveryClaimTimeoutMs =
+    typeof timeoutMs === "number" && Number.isFinite(timeoutMs) && timeoutMs > 0
+      ? timeoutMs
+      : DEFAULT_RUN_SAFETY_DELIVERY_CLAIM_TIMEOUT_MS;
+}
+
+export function hasRunSafetyDeliveryReceipt(
+  termination: Pick<RunSafetyTermination, "rootInvocationId" | "kind">,
+): boolean {
+  return deliveredRunSafetyKeys.has(buildRunSafetyDeliveryKey(termination));
+}
+
+export function recordRunSafetyDeliveryReceipt(
+  termination: Pick<RunSafetyTermination, "rootInvocationId" | "kind">,
+): boolean {
+  const key = buildRunSafetyDeliveryKey(termination);
+  if (deliveredRunSafetyKeys.has(key)) {
+    return false;
+  }
+  while (deliveredRunSafetyKeys.size >= MAX_DELIVERED_RUN_SAFETY_KEYS) {
+    const oldest = deliveredRunSafetyKeys.values().next().value;
+    if (typeof oldest !== "string") {
+      break;
+    }
+    deliveredRunSafetyKeys.delete(oldest);
+  }
+  deliveredRunSafetyKeys.add(key);
+  settleRunSafetyDeliveryAttempt(key, true);
+  return true;
+}
+
+function settleRunSafetyDeliveryAttempt(key: string, delivered: boolean): void {
+  const attempt = inFlightRunSafetyDeliveries.get(key);
+  if (!attempt) {
+    return;
+  }
+  inFlightRunSafetyDeliveries.delete(key);
+  clearTimeout(attempt.expiryTimer);
+  attempt.resolve(delivered);
+}
+
+export async function waitForRunSafetyDeliveryReceipt(
+  termination: Pick<RunSafetyTermination, "rootInvocationId" | "kind">,
+): Promise<boolean> {
+  if (hasRunSafetyDeliveryReceipt(termination)) {
+    return true;
+  }
+  const attempt = inFlightRunSafetyDeliveries.get(buildRunSafetyDeliveryKey(termination));
+  return attempt ? await attempt.promise : false;
+}
+
+/**
+ * Owner callbacks can race the ordinary root-result delivery path. Wait for
+ * that in-flight attempt first; only claim a retry after an explicit failure.
+ */
+export async function buildRunSafetyNativeReplyPayloadsForOwner(
+  params: Parameters<typeof buildRunSafetyNativeReplyPayloads>[0],
+): Promise<ReplyPayload[]> {
+  const payloads = buildRunSafetyNativeReplyPayloads(params);
+  if (payloads.length > 0 || !params.termination) {
+    return payloads;
+  }
+  if (await waitForRunSafetyDeliveryReceipt(params.termination)) {
+    return [];
+  }
+  return buildRunSafetyNativeReplyPayloads(params);
+}
+
+export function recordRunSafetyDeliveryReceiptForPayload(
+  payload: ReplyPayload,
+  deliveryResult?: unknown,
+): boolean {
+  const identity = getReplyPayloadMetadata(payload)?.runSafetyDelivery;
+  if (!identity) {
+    return false;
+  }
+  if (
+    typeof identity.rootInvocationId !== "string" ||
+    !identity.rootInvocationId ||
+    typeof identity.kind !== "string"
+  ) {
+    return false;
+  }
+  const key = buildRunSafetyDeliveryKey({
+    rootInvocationId: identity.rootInvocationId,
+    kind: identity.kind as RunSafetyTerminationKind,
+  });
+  if (deliveryResult === false || deliveryResult === null) {
+    settleRunSafetyDeliveryAttempt(key, false);
+    return false;
+  }
+  if (deliveryResult && typeof deliveryResult === "object") {
+    const result = deliveryResult as {
+      ok?: unknown;
+      delivered?: unknown;
+      suppressed?: unknown;
+    };
+    if (result.ok === false || result.delivered === false || result.suppressed === true) {
+      settleRunSafetyDeliveryAttempt(key, false);
+      return false;
+    }
+  }
+  return recordRunSafetyDeliveryReceipt({
+    rootInvocationId: identity.rootInvocationId,
+    kind: identity.kind as RunSafetyTerminationKind,
+  });
+}
+
+export const resetRunSafetyDeliveryReceiptsForTests = (): void => {
+  deliveredRunSafetyKeys.clear();
+  for (const attempt of inFlightRunSafetyDeliveries.values()) {
+    clearTimeout(attempt.expiryTimer);
+    attempt.resolve(false);
+  }
+  inFlightRunSafetyDeliveries.clear();
+  runSafetyDeliveryClaimTimeoutMs = DEFAULT_RUN_SAFETY_DELIVERY_CLAIM_TIMEOUT_MS;
+};
