+import type { AgentMessage } from "openclaw/plugin-sdk/agent-core";
+import { SessionManager } from "openclaw/plugin-sdk/agent-sessions";
+import type { AssistantMessage, ToolResultMessage, UserMessage } from "openclaw/plugin-sdk/llm";
+import { describe, expect, it, vi } from "vitest";
+import { makeAgentAssistantMessage } from "../test-helpers/agent-message-fixtures.js";
+import type { TranscriptPolicy } from "../transcript-policy.js";
+import { sanitizeSessionHistory } from "./replay-history.js";
+
+vi.mock("../../plugins/provider-runtime.js", () => ({
+  resolveProviderRuntimePlugin: () => undefined,
+  sanitizeProviderReplayHistoryWithPlugin: () => undefined,
+  validateProviderReplayTurnsWithPlugin: () => undefined,
+}));
+
+vi.mock("../../plugins/provider-hook-runtime.js", () => ({
+  resolveProviderRuntimePlugin: () => undefined,
+}));
+
+const PASSTHROUGH_POLICY: TranscriptPolicy = {
+  sanitizeMode: "images-only",
+  sanitizeToolCallIds: false,
+  preserveNativeAnthropicToolUseIds: false,
+  repairToolUseResultPairing: false,
+  preserveSignatures: false,
+  sanitizeThinkingSignatures: false,
+  dropThinkingBlocks: false,
+  applyGoogleTurnOrdering: false,
+  validateGeminiTurns: false,
+  validateAnthropicTurns: false,
+  allowSyntheticToolResults: false,
+};
+
+type PairOptions = {
+  assistantText?: string;
+  includeThinking?: boolean;
+  path?: string;
+  resultText?: string;
+  resultId?: string;
+  toolName?: string;
+  toolCalls?: number;
+};
+
+function makePowerShellCommand(windowSize: number, path = "C:\\project\\artifacts"): string {
+  return `Get-ChildItem -Path "${path}" -Name | Sort-Object LastWriteTime -Descending | Select-Object -First ${windowSize}`;
+}
+
+function makePair(index: number, options: PairOptions = {}): AgentMessage[] {
+  const toolName = options.toolName ?? "exec";
+  const toolCallCount = options.toolCalls ?? 1;
+  const content: AssistantMessage["content"] =
+    options.includeThinking === false
+      ? []
+      : [{ type: "thinking", thinking: `checking window ${index}` }];
+  if (options.assistantText !== undefined) {
+    content.push({ type: "text", text: options.assistantText });
+  }
+  for (let callIndex = 0; callIndex < toolCallCount; callIndex += 1) {
+    content.push({
+      type: "toolCall",
+      id: `call${index}-${callIndex}`,
+      name: toolName,
+      arguments:
+        toolName === "exec"
+          ? {
+              command: makePowerShellCommand(80 + index * 20 + callIndex, options.path),
+            }
+          : { path: `report-${index}-${callIndex}.md`, content: "updated" },
+    });
+  }
+
+  const messages: AgentMessage[] = [
+    makeAgentAssistantMessage({
+      content,
+      model: "gpt-5.4",
+      stopReason: "toolUse",
+      timestamp: index * 10,
+    }),
+  ];
+  for (let callIndex = 0; callIndex < toolCallCount; callIndex += 1) {
+    const id =
+      callIndex === 0 && options.resultId !== undefined
+        ? options.resultId
+        : `call${index}-${callIndex}`;
+    const resultText = options.resultText ?? "report-a.md\nreport-b.md";
+    messages.push({
+      role: "toolResult",
+      toolCallId: id,
+      toolName,
+      isError: false,
+      content: [{ type: "text", text: resultText }],
+      details: {
+        status: "completed",
+        exitCode: 0,
+        aggregated: resultText,
+        durationMs: 100 + index,
+        cwd: `C:\\temp\\run-${index}`,
+      },
+      timestamp: index * 10 + callIndex + 1,
+    } satisfies ToolResultMessage<Record<string, unknown>>);
+  }
+  return messages;
+}
+
+function makeHistory(
+  count: number,
+  optionsForIndex: (index: number) => PairOptions = () => ({}),
+): AgentMessage[] {
+  const messages = Array.from({ length: count }, (_, index) =>
+    makePair(index, optionsForIndex(index)),
+  ).flat();
+  messages.push({
+    role: "user",
+    content: "continue",
+    timestamp: count * 10 + 1,
+  } satisfies UserMessage);
+  return messages;
+}
+
+async function sanitize(messages: AgentMessage[]): Promise<AgentMessage[]> {
+  return await sanitizeSessionHistory({
+    messages,
+    modelApi: "test-api",
+    provider: "test-provider",
+    modelId: "test-model",
+    policy: PASSTHROUGH_POLICY,
+    sessionManager: SessionManager.inMemory(),
+    sessionId: "variant-history-test",
+  });
+}
+
+function toolCallIds(messages: AgentMessage[]): string[] {
+  return messages.flatMap((message) => {
+    if (message.role !== "assistant" || !Array.isArray(message.content)) {
+      return [];
+    }
+    return message.content.flatMap((block) => (block.type === "toolCall" ? [block.id] : []));
+  });
+}
+
+function expectStrictToolPairs(messages: AgentMessage[]): void {
+  for (let index = 0; index < messages.length; index += 1) {
+    const assistant = messages[index];
+    if (assistant?.role !== "assistant") {
+      continue;
+    }
+    const ids = Array.isArray(assistant.content)
+      ? assistant.content.flatMap((block) => (block.type === "toolCall" ? [block.id] : []))
+      : [];
+    expect(ids).toHaveLength(1);
+    const result = messages[index + 1];
+    expect(result?.role).toBe("toolResult");
+    if (result?.role === "toolResult") {
+      expect(result.toolCallId).toBe(ids[0]);
+    }
+  }
+}
+
+describe("sanitizeSessionHistory repeated tool history folding", () => {
+  it("folds four consecutive same-family same-result pairs to the latest two", async () => {
+    const sanitized = await sanitize(makeHistory(4));
+
+    expect(sanitized).toHaveLength(5);
+    expect(toolCallIds(sanitized)).toEqual(["call2-0", "call3-0"]);
+  });
+
+  it("folds a 200-pair replay storm without mutating the persisted message array", async () => {
+    const messages = makeHistory(200);
+    const original = structuredClone(messages);
+
+    const sanitized = await sanitize(messages);
+
+    expect(sanitized).toHaveLength(5);
+    expect(toolCallIds(sanitized)).toEqual(["call198-0", "call199-0"]);
+    expectStrictToolPairs(sanitized);
+    expect(messages).toEqual(original);
+  });
+
+  it("does not fold below the four-pair threshold", async () => {
+    const sanitized = await sanitize(makeHistory(3));
+
+    expect(sanitized).toHaveLength(7);
+    expect(toolCallIds(sanitized)).toEqual(["call0-0", "call1-0", "call2-0"]);
+  });
+
+  it("keeps groups with changing results or business paths", async () => {
+    const changingResults = await sanitize(
+      makeHistory(4, (index) => ({ resultText: index < 2 ? "same" : `changed-${index}` })),
+    );
+    const changingPaths = await sanitize(
+      makeHistory(4, (index) => ({ path: `C:\\project-${index}\\artifacts` })),
+    );
+
+    expect(toolCallIds(changingResults)).toHaveLength(4);
+    expect(toolCallIds(changingPaths)).toHaveLength(4);
+  });
+
+  it("excludes assistant turns with visible text", async () => {
+    const sanitized = await sanitize(
+      makeHistory(4, () => ({ assistantText: "I am still checking." })),
+    );
+
+    expect(toolCallIds(sanitized)).toHaveLength(4);
+  });
+
+  it("excludes tool-call turns without a thinking block", async () => {
+    const sanitized = await sanitize(makeHistory(4, () => ({ includeThinking: false })));
+
+    expect(toolCallIds(sanitized)).toHaveLength(4);
+  });
+
+  it("excludes parallel tool-call turns", async () => {
+    const sanitized = await sanitize(makeHistory(4, () => ({ toolCalls: 2 })));
+
+    expect(toolCallIds(sanitized)).toHaveLength(8);
+  });
+
+  it.each(["write", "business_lookup"])(
+    "excludes the %s side-effect or unregistered tool family",
+    async (toolName) => {
+      const sanitized = await sanitize(makeHistory(4, () => ({ toolName })));
+
+      expect(toolCallIds(sanitized)).toHaveLength(4);
+    },
+  );
+
+  it("requires an exact assistant/toolResult id pair", async () => {
+    const sanitized = await sanitize(
+      makeHistory(4, (index) => ({ resultId: `different${index}` })),
+    );
+
+    expect(toolCallIds(sanitized)).toHaveLength(4);
+  });
+});
