+  RunSafetyDeliveryLocale,
+  waitForRunSafetyDeliveryReceipt,
+} from "./run-safety-delivery.js";
+
+function termination(
+  kind: RunSafetyTermination["kind"] = RunSafetyTerminationKind.VariantNoProgress,
+): RunSafetyTermination {
+  return {
+    kind,
+    rootInvocationId: "root-1",
+    budgetScopeId: "scope-1",
+    runId: "run-1",
+  };
+}
+
+afterEach(() => {
+  resetRunSafetyDeliveryReceiptsForTests();
+});
+
+describe("run safety native delivery", () => {
+  test("selects Chinese for CJK input and otherwise defaults to English", () => {
+    expect(resolveRunSafetyDeliveryLocale("请把文件发给我")).toBe(RunSafetyDeliveryLocale.Chinese);
+    expect(resolveRunSafetyDeliveryLocale("send me the files")).toBe(
+      RunSafetyDeliveryLocale.English,
+    );
+    expect(resolveRunSafetyDeliveryLocale()).toBe(RunSafetyDeliveryLocale.English);
+  });
+
+  test.each(Object.values(RunSafetyTerminationKind))(
+    "builds distinct deterministic Chinese and English payloads for %s",
+    (kind) => {
+      const reason = termination(kind);
+      const zh = buildRunSafetyReplyPayload({
+        termination: reason,
+        locale: RunSafetyDeliveryLocale.Chinese,
+      });
+      const en = buildRunSafetyReplyPayload({
+        termination: reason,
+        locale: RunSafetyDeliveryLocale.English,
+      });
+      expect(zh.text).toBeTruthy();
+      expect(en.text).toBeTruthy();
+      expect(zh.text).not.toBe(en.text);
+      expect(zh.isError).toBeUndefined();
+      expect(en.isError).toBeUndefined();
+      expect(recordRunSafetyDeliveryReceiptForPayload(zh, { ok: false })).toBe(false);
+      expect(hasRunSafetyDeliveryReceipt(reason)).toBe(false);
+      expect(recordRunSafetyDeliveryReceiptForPayload(zh, { ok: true })).toBe(true);
+      expect(hasRunSafetyDeliveryReceipt(reason)).toBe(true);
+      resetRunSafetyDeliveryReceiptsForTests();
+    },
+  );
+
+  test("deduplicates receipts by root invocation and kind, not child run id", () => {
+    const first = termination();
+    const child = {
+      ...first,
+      runId: "run-child",
+      budgetScopeId: "scope-child",
+    };
+    expect(buildRunSafetyDeliveryKey(first)).toBe(buildRunSafetyDeliveryKey(child));
+    expect(hasRunSafetyDeliveryReceipt(first)).toBe(false);
+    expect(recordRunSafetyDeliveryReceipt(first)).toBe(true);
+    expect(hasRunSafetyDeliveryReceipt(child)).toBe(true);
+    expect(recordRunSafetyDeliveryReceipt(child)).toBe(false);
+  });
+
+  test("does not share a receipt between distinct terminal kinds", () => {
+    const variant = termination(RunSafetyTerminationKind.VariantNoProgress);
+    const budget = termination(RunSafetyTerminationKind.RunToolBudget);
+    expect(recordRunSafetyDeliveryReceipt(variant)).toBe(true);
+    expect(hasRunSafetyDeliveryReceipt(budget)).toBe(false);
+    expect(recordRunSafetyDeliveryReceipt(budget)).toBe(true);
+  });
+
+  test("does not record a receipt for ordinary payloads or failed delivery", () => {
+    expect(recordRunSafetyDeliveryReceiptForPayload({ text: "ordinary" }, { ok: true })).toBe(
+      false,
+    );
+    const payload = buildRunSafetyReplyPayload({
+      termination: termination(),
+      locale: RunSafetyDeliveryLocale.English,
+    });
+    expect(recordRunSafetyDeliveryReceiptForPayload(payload, false)).toBe(false);
+    expect(recordRunSafetyDeliveryReceiptForPayload(payload, { delivered: false })).toBe(false);
+    expect(hasRunSafetyDeliveryReceipt(termination())).toBe(false);
+  });
+
+  test("replaces provider output with exactly one deterministic local safety reply", () => {
+    const reason = termination(RunSafetyTerminationKind.RunProviderDispatchBudget);
+    const payloads = buildRunSafetyNativeReplyPayloads({
+      termination: reason,
+      providerPayloads: [{ text: "provider-generated fallback summary", isError: true }],
+      sourceText: "请继续处理",
+    });
+    expect(payloads).toHaveLength(1);
+    expect(payloads[0]?.text).toContain("模型请求次数");
+    expect(payloads[0]?.isError).toBeUndefined();
+
+    expect(recordRunSafetyDeliveryReceiptForPayload(payloads[0]!, { ok: true })).toBe(true);
+    expect(
+      buildRunSafetyNativeReplyPayloads({
+        termination: { ...reason, runId: "child-run" },
+        sourceText: "请继续处理",
+      }),
+    ).toEqual([]);
+  });
+
+  test("arbitrates a root-result and late-child delivery race through one in-flight claim", async () => {
+    const reason = termination(RunSafetyTerminationKind.RunToolBudget);
+    const rootPayloads = buildRunSafetyNativeReplyPayloads({
+      termination: reason,
+      sourceText: "continue",
+    });
+    expect(rootPayloads).toHaveLength(1);
+
+    const lateChildPayloads = buildRunSafetyNativeReplyPayloads({
+      termination: { ...reason, runId: "late-child" },
+      sourceText: "continue",
+    });
+    expect(lateChildPayloads).toEqual([]);
+
+    let waiterSettled = false;
+    const waiter = waitForRunSafetyDeliveryReceipt(reason).then((delivered) => {
+      waiterSettled = true;
+      return delivered;
+    });
+    await Promise.resolve();
+    expect(waiterSettled).toBe(false);
+
+    expect(recordRunSafetyDeliveryReceiptForPayload(rootPayloads[0]!, { ok: true })).toBe(true);
+    await expect(waiter).resolves.toBe(true);
+    expect(
+      buildRunSafetyNativeReplyPayloads({
+        termination: { ...reason, runId: "another-child" },
+      }),
+    ).toEqual([]);
+  });
+
+  test("releases a failed in-flight claim so the owner can retry", async () => {
+    const reason = termination(RunSafetyTerminationKind.RunPromptExposureBudget);
+    const firstAttempt = buildRunSafetyNativeReplyPayloads({
+      termination: reason,
+      sourceText: "continue",
+    });
+    expect(firstAttempt).toHaveLength(1);
+    const waiter = waitForRunSafetyDeliveryReceipt(reason);
+
+    expect(recordRunSafetyDeliveryReceiptForPayload(firstAttempt[0]!, { ok: false })).toBe(false);
+    await expect(waiter).resolves.toBe(false);
+    expect(hasRunSafetyDeliveryReceipt(reason)).toBe(false);
+
+    const retry = buildRunSafetyNativeReplyPayloads({
+      termination: { ...reason, runId: "retry-owner" },
+      sourceText: "continue",
+    });
+    expect(retry).toHaveLength(1);
+    expect(recordRunSafetyDeliveryReceiptForPayload(retry[0]!, { delivered: true })).toBe(true);
+    expect(hasRunSafetyDeliveryReceipt(reason)).toBe(true);
+  });
+
+  test("preserves ordinary provider payloads when there is no safety terminal", () => {
+    const providerPayloads = [{ text: "normal" }, { text: "second" }];
+    expect(buildRunSafetyNativeReplyPayloads({ providerPayloads })).toEqual(providerPayloads);
+  });
+});
