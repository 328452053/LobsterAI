diff --git a/src/agents/harness/run-safety-contract.test.ts b/src/agents/harness/run-safety-contract.test.ts
new file mode 100644
index 000000000..ff435393d
--- /dev/null
+++ b/src/agents/harness/run-safety-contract.test.ts
@@ -0,0 +1,174 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  RunSafetyController,
+  RunSafetyRootCoordinator,
+  type RunSafetyBudgetLimits,
+  type RunSafetyContext,
+} from "../run-safety-controller.js";
+import {
+  createAgentHarnessCompactV1,
+  createAgentHarnessRunAttemptV1,
+  runAgentHarnessAttemptV1,
+  runAgentHarnessCompactV1,
+} from "./run-safety-contract.js";
+import type {
+  AgentHarnessAttemptParams,
+  AgentHarnessAttemptResult,
+  AgentHarnessCompactParams,
+} from "./types.js";
+
+function createRunSafety(
+  limits: Partial<RunSafetyBudgetLimits> = {},
+  runId = "run-1",
+): RunSafetyContext {
+  const rootInvocationId = "root-1";
+  return {
+    coordinator: new RunSafetyRootCoordinator(rootInvocationId),
+    controller: new RunSafetyController({
+      rootInvocationId,
+      rootRunId: runId,
+      limits,
+    }),
+  };
+}
+
+function createAttemptParams(runSafety = createRunSafety()): AgentHarnessAttemptParams {
+  return {
+    runId: "run-1",
+    runSafety,
+    model: { id: "model-1", provider: "test", contextWindow: 100_000 },
+  } as AgentHarnessAttemptParams;
+}
+
+function createAttemptResult(): AgentHarnessAttemptResult {
+  return { aborted: false } as AgentHarnessAttemptResult;
+}
+
+describe("AgentHarness run-safety V1 contract", () => {
+  it("rejects an unversioned attempt before invoking plugin code", async () => {
+    const legacy = vi.fn(async () => createAttemptResult());
+
+    await expect(
+      runAgentHarnessAttemptV1({
+        handler: undefined,
+        legacyHandlerPresent: true,
+        attemptParams: createAttemptParams(),
+      }),
+    ).rejects.toThrow("Unversioned AgentHarness runAttempt is not permitted.");
+    expect(legacy).not.toHaveBeenCalled();
+  });
+
+  it("counts one normal send as one provider dispatch", async () => {
+    const params = createAttemptParams();
+    const transport = vi.fn(async () => "sent");
+    const handler = createAgentHarnessRunAttemptV1(async (attemptParams, host) => {
+      await host.dispatch({
+        finalPayload: { prompt: "hello", config: { model: "model-1" } },
+        model: attemptParams.model,
+        transport,
+      });
+      return createAttemptResult();
+    });
+
+    await runAgentHarnessAttemptV1({
+      handler,
+      legacyHandlerPresent: false,
+      attemptParams: params,
+    });
+
+    expect(transport).toHaveBeenCalledOnce();
+    expect(params.runSafety?.controller.snapshot().providerDispatchCount).toBe(1);
+  });
+
+  it("creates a new ticket for each recovery send on the shared controller", async () => {
+    const params = createAttemptParams();
+    const transport = vi.fn(async () => "sent");
+    const handler = createAgentHarnessRunAttemptV1(async (_attemptParams, host) => {
+      await host.dispatch({ finalPayload: { prompt: "first" }, transport });
+      await host.dispatch({ finalPayload: { prompt: "retry" }, transport });
+      return createAttemptResult();
+    });
+
+    await runAgentHarnessAttemptV1({
+      handler,
+      legacyHandlerPresent: false,
+      attemptParams: params,
+    });
+
+    expect(transport).toHaveBeenCalledTimes(2);
+    expect(params.runSafety?.controller.snapshot().providerDispatchCount).toBe(2);
+  });
+
+  it("does not call transport when the dispatch limit is exhausted", async () => {
+    const runSafety = createRunSafety({ maxProviderDispatchesPerBudgetScope: 1 });
+    const providerDispatchId = runSafety.controller.createProviderDispatchId("run-1");
+    runSafety.controller.reserveProviderDispatch({
+      runId: "run-1",
+      providerDispatchId,
+      estimatedPromptTokens: 1,
+    });
+    runSafety.controller.completeProviderDispatch(providerDispatchId);
+    const transport = vi.fn(async () => "sent");
+    const handler = createAgentHarnessRunAttemptV1(async (_attemptParams, host) => {
+      await host.dispatch({ finalPayload: { prompt: "blocked" }, transport });
+      return createAttemptResult();
+    });
+
+    await expect(
+      runAgentHarnessAttemptV1({
+        handler,
+        legacyHandlerPresent: false,
+        attemptParams: createAttemptParams(runSafety),
+      }),
+    ).rejects.toThrow("blocked by run safety");
+    expect(transport).not.toHaveBeenCalled();
+  });
+
+  it("does not call transport when final prompt exposure exceeds the limit", async () => {
+    const runSafety = createRunSafety({
+      maxCumulativeEstimatedPromptTokensPerBudgetScope: 32,
+    });
+    const transport = vi.fn(async () => "sent");
+    const handler = createAgentHarnessRunAttemptV1(async (_attemptParams, host) => {
+      await host.dispatch({
+        finalPayload: { prompt: "x".repeat(1_000) },
+        transport,
+      });
+      return createAttemptResult();
+    });
+
+    await expect(
+      runAgentHarnessAttemptV1({
+        handler,
+        legacyHandlerPresent: false,
+        attemptParams: createAttemptParams(runSafety),
+      }),
+    ).rejects.toThrow("prompt exposure was blocked");
+    expect(transport).not.toHaveBeenCalled();
+  });
+
+  it("requires the same versioned seam for harness compaction", async () => {
+    const runSafety = createRunSafety();
+    const compactParams = {
+      runId: "run-1",
+      runSafety,
+    } as AgentHarnessCompactParams;
+    const transport = vi.fn(async () => "compacted");
+    const handler = createAgentHarnessCompactV1(async (_params, host) => {
+      await host.dispatch({
+        finalPayload: { operation: "compact", threadId: "thread-1" },
+        transport,
+      });
+      return { ok: true, compacted: true };
+    });
+
+    await runAgentHarnessCompactV1({
+      handler,
+      legacyHandlerPresent: false,
+      compactParams,
+    });
+
+    expect(transport).toHaveBeenCalledOnce();
+    expect(runSafety.controller.snapshot().providerDispatchCount).toBe(1);
+  });
+});
diff --git a/src/agents/harness/run-safety-contract.ts b/src/agents/harness/run-safety-contract.ts
new file mode 100644
index 000000000..d7573b229
--- /dev/null
+++ b/src/agents/harness/run-safety-contract.ts
@@ -0,0 +1,169 @@
+import type { Model } from "../../llm/types.js";
+import {
+  estimateRunSafetyPromptTokens,
+  type RunSafetyContext,
+  type RunSafetyTermination,
+  RunSafetyTerminationKind,
+} from "../run-safety-controller.js";
+import type {
+  AgentHarnessAttemptParams,
+  AgentHarnessAttemptResult,
+  AgentHarnessCompactParams,
+  AgentHarnessCompactResult,
+} from "./types.js";
+
+export const AgentHarnessRunSafetyContractVersion = {
+  V1: 1,
+} as const;
+
+export type AgentHarnessRunSafetyDispatchV1 = <T>(params: {
+  finalPayload: unknown;
+  model?: Pick<Model, "contextWindow">;
+  transport: (finalPayload: unknown) => Promise<T>;
+}) => Promise<T>;
+
+export type AgentHarnessRunSafetyHostV1 = Readonly<{
+  contractVersion: typeof AgentHarnessRunSafetyContractVersion.V1;
+  dispatch: AgentHarnessRunSafetyDispatchV1;
+}>;
+
+export type AgentHarnessRunAttemptHandlerV1 = (
+  params: AgentHarnessAttemptParams,
+  host: AgentHarnessRunSafetyHostV1,
+) => Promise<AgentHarnessAttemptResult>;
+
+export type AgentHarnessCompactHandlerV1 = (
+  params: AgentHarnessCompactParams,
+  host: AgentHarnessRunSafetyHostV1,
+) => Promise<AgentHarnessCompactResult | undefined>;
+
+const runAttemptHandlersV1 = new WeakSet<AgentHarnessRunAttemptHandlerV1>();
+const compactHandlersV1 = new WeakSet<AgentHarnessCompactHandlerV1>();
+
+export class AgentHarnessRunSafetyContractError extends Error {
+  constructor(
+    message: string,
+    readonly terminationReason?: RunSafetyTermination,
+  ) {
+    super(message);
+    this.name = "AgentHarnessRunSafetyContractError";
+  }
+}
+
+/**
+ * Marks a trusted in-process harness handler as implementing V1.
+ *
+ * V1 structurally gives audited harnesses a host-owned dispatch callback, but
+ * it is not an in-process plugin sandbox. A malicious plugin could perform
+ * network I/O outside `dispatch`; AgentHarness plugins remain trusted code.
+ * The host therefore uses this private WeakSet rather than a self-reported
+ * property, and built-in handlers must keep every real provider send inside
+ * the callback.
+ */
+export function createAgentHarnessRunAttemptV1(
+  handler: AgentHarnessRunAttemptHandlerV1,
+): AgentHarnessRunAttemptHandlerV1 {
+  runAttemptHandlersV1.add(handler);
+  return handler;
+}
+
+export function createAgentHarnessCompactV1(
+  handler: AgentHarnessCompactHandlerV1,
+): AgentHarnessCompactHandlerV1 {
+  compactHandlersV1.add(handler);
+  return handler;
+}
+
+function createRunSafetyHostV1(params: {
+  runId?: string;
+  runSafety?: RunSafetyContext;
+}): AgentHarnessRunSafetyHostV1 {
+  const runId = params.runId?.trim();
+  const runSafety = params.runSafety;
+  if (!runId || !runSafety?.controller) {
+    throw new AgentHarnessRunSafetyContractError(
+      "Agent harness V1 requires a host-owned run-safety scope and run id.",
+    );
+  }
+
+  const dispatch: AgentHarnessRunSafetyDispatchV1 = async ({ finalPayload, model, transport }) => {
+    const providerDispatchId = runSafety.controller.createProviderDispatchId(runId);
+    const reservation = runSafety.controller.reserveProviderDispatch({
+      runId,
+      providerDispatchId,
+      // Reserve the logical send first. Final prompt exposure is authoritative
+      // only after the harness has supplied its immutable dispatch payload.
+      estimatedPromptTokens: 1,
+    });
+    if (!reservation.allowed) {
+      throw new AgentHarnessRunSafetyContractError(
+        "Agent harness provider dispatch was blocked by run safety.",
+        reservation.reason,
+      );
+    }
+    try {
+      const estimate = estimateRunSafetyPromptTokens(finalPayload, model);
+      if (!estimate.ok) {
+        const reason = runSafety.controller.tryTerminate({
+          kind: RunSafetyTerminationKind.RunPromptEstimateUnavailable,
+          runId,
+        });
+        throw new AgentHarnessRunSafetyContractError(
+          "Agent harness final payload could not be estimated safely.",
+          reason,
+        );
+      }
+      const refinement = runSafety.controller.refineProviderPromptEstimate({
+        runId,
+        providerDispatchId,
+        estimatedPromptTokens: estimate.estimatedPromptTokens,
+      });
+      if (!refinement.allowed) {
+        throw new AgentHarnessRunSafetyContractError(
+          "Agent harness prompt exposure was blocked by run safety.",
+          refinement.reason,
+        );
+      }
+      return await transport(finalPayload);
+    } finally {
+      runSafety.controller.completeProviderDispatch(providerDispatchId);
+    }
+  };
+
+  return Object.freeze({
+    contractVersion: AgentHarnessRunSafetyContractVersion.V1,
+    dispatch,
+  });
+}
+
+export async function runAgentHarnessAttemptV1(params: {
+  handler: AgentHarnessRunAttemptHandlerV1 | undefined;
+  legacyHandlerPresent: boolean;
+  attemptParams: AgentHarnessAttemptParams;
+}): Promise<AgentHarnessAttemptResult> {
+  if (!params.handler || !runAttemptHandlersV1.has(params.handler)) {
+    throw new AgentHarnessRunSafetyContractError(
+      params.legacyHandlerPresent
+        ? "Unversioned AgentHarness runAttempt is not permitted."
+        : "AgentHarness does not provide the mandatory runAttemptV1 capability.",
+    );
+  }
+  const host = createRunSafetyHostV1(params.attemptParams);
+  return await params.handler(params.attemptParams, host);
+}
+
+export async function runAgentHarnessCompactV1(params: {
+  handler: AgentHarnessCompactHandlerV1 | undefined;
+  legacyHandlerPresent: boolean;
+  compactParams: AgentHarnessCompactParams;
+}): Promise<AgentHarnessCompactResult | undefined> {
+  if (!params.handler || !compactHandlersV1.has(params.handler)) {
+    throw new AgentHarnessRunSafetyContractError(
+      params.legacyHandlerPresent
+        ? "Unversioned AgentHarness compact is not permitted."
+        : "AgentHarness does not provide the mandatory compactV1 capability.",
+    );
+  }
+  const host = createRunSafetyHostV1(params.compactParams);
+  return await params.handler(params.compactParams, host);
+}
