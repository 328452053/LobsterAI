new file mode 100644
index 000000000..6ef0cae47
--- /dev/null
+++ b/src/agents/harness/run-safety-contract.test.ts
@@ -0,0 +1,218 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  RunSafetyController,
+  RunSafetyRootCoordinator,
+  type RunSafetyControllerLimits,
+  type RunSafetyContext,
+} from "../run-safety-controller.js";
+import {
+  createAgentHarnessCompactV1,
+  createAgentHarnessRunAttemptV1,
+  runAgentHarnessAttemptV1,
+  runAgentHarnessCompactV1,
+} from "./run-safety-contract.js";
+import type {
+  AgentHarnessAttemptParams,
+  AgentHarnessAttemptResult,
+  AgentHarnessCompactParams,
+} from "./types.js";
+
+function createRunSafety(
+  limits: RunSafetyControllerLimits = {},
+  runId = "run-1",
+): RunSafetyContext {
+  const rootInvocationId = "root-1";
+  return {
+    coordinator: new RunSafetyRootCoordinator(rootInvocationId),
+    controller: new RunSafetyController({
+      rootInvocationId,
+      rootRunId: runId,
+      limits,
+    }),
+  };
+}
+
+function createAttemptParams(runSafety = createRunSafety()): AgentHarnessAttemptParams {
+  return {
+    runId: "run-1",
+    runSafety,
+    model: { id: "model-1", provider: "test", contextWindow: 100_000 },
+  } as AgentHarnessAttemptParams;
+}
+
+function createAttemptResult(): AgentHarnessAttemptResult {
+  return { aborted: false } as AgentHarnessAttemptResult;
+}
+
+describe("AgentHarness run-safety V1 contract", () => {
+  it("rejects an unversioned attempt before invoking plugin code", async () => {
+    const legacy = vi.fn(async () => createAttemptResult());
+
+    await expect(
+      runAgentHarnessAttemptV1({
+        handler: undefined,
+        legacyHandlerPresent: true,
+        attemptParams: createAttemptParams(),
+      }),
+    ).rejects.toThrow("Unversioned AgentHarness runAttempt is not permitted.");
+    expect(legacy).not.toHaveBeenCalled();
+  });
+
+  it("counts one normal send as one provider dispatch", async () => {
+    const params = createAttemptParams();
+    const transport = vi.fn(async () => "sent");
+    const handler = createAgentHarnessRunAttemptV1(async (attemptParams, host) => {
+      await host.dispatch({
+        finalPayload: { prompt: "hello", config: { model: "model-1" } },
+        model: attemptParams.model,
+        transport,
+      });
+      return createAttemptResult();
+    });
+
+    await runAgentHarnessAttemptV1({
+      handler,
+      legacyHandlerPresent: false,
+      attemptParams: params,
+    });
+
+    expect(transport).toHaveBeenCalledOnce();
+    expect(params.runSafety?.controller.snapshot().providerDispatchCount).toBe(1);
+  });
+
+  it("creates a new ticket for each recovery send on the shared controller", async () => {
+    const params = createAttemptParams();
+    const transport = vi.fn(async () => "sent");
+    const handler = createAgentHarnessRunAttemptV1(async (_attemptParams, host) => {
+      await host.dispatch({ finalPayload: { prompt: "first" }, transport });
+      await host.dispatch({ finalPayload: { prompt: "retry" }, transport });
+      return createAttemptResult();
+    });
+
+    await runAgentHarnessAttemptV1({
+      handler,
+      legacyHandlerPresent: false,
+      attemptParams: params,
+    });
+
+    expect(transport).toHaveBeenCalledTimes(2);
+    expect(params.runSafety?.controller.snapshot().providerDispatchCount).toBe(2);
+  });
+
+  it("does not call transport when the dispatch limit is exhausted", async () => {
+    const runSafety = createRunSafety({ maxProviderDispatchesPerBudgetScope: 1 });
+    const providerDispatchId = runSafety.controller.createProviderDispatchId("run-1");
+    runSafety.controller.reserveProviderDispatch({
+      runId: "run-1",
+      providerDispatchId,
+    });
+    runSafety.controller.completeProviderDispatch(providerDispatchId);
+    const transport = vi.fn(async () => "sent");
+    const handler = createAgentHarnessRunAttemptV1(async (_attemptParams, host) => {
+      await host.dispatch({ finalPayload: { prompt: "blocked" }, transport });
+      return createAttemptResult();
+    });
+
+    await expect(
+      runAgentHarnessAttemptV1({
+        handler,
+        legacyHandlerPresent: false,
+        attemptParams: createAttemptParams(runSafety),
+      }),
+    ).rejects.toThrow("blocked by run safety");
+    expect(transport).not.toHaveBeenCalled();
+  });
+
+  it("calls transport when final prompt exposure exceeds the legacy threshold", async () => {
+    const runSafety = createRunSafety({
+      promptExposure: { mode: "observe", legacyDiagnosticThreshold: 32 },
+    });
+    const transport = vi.fn(async () => "sent");
+    const handler = createAgentHarnessRunAttemptV1(async (_attemptParams, host) => {
+      await host.dispatch({
+        finalPayload: { prompt: "x".repeat(1_000) },
+        transport,
+      });
+      return createAttemptResult();
+    });
+
+    await runAgentHarnessAttemptV1({
+      handler,
+      legacyHandlerPresent: false,
+      attemptParams: createAttemptParams(runSafety),
+    });
+
+    expect(transport).toHaveBeenCalledOnce();
+    expect(runSafety.controller.terminationReason).toBeUndefined();
+    expect(runSafety.controller.snapshot().promptExposure).toMatchObject({
+      legacyDiagnosticThresholdCrossed: true,
+      knownEstimateDispatchCount: 1,
+      pendingObservationDispatchCount: 0,
+    });
+  });
+
+  it("calls transport when final prompt estimation is unavailable", async () => {
+    const runSafety = createRunSafety();
+    const transport = vi.fn(async () => "sent");
+    const handler = createAgentHarnessRunAttemptV1(async (_attemptParams, host) => {
+      await host.dispatch({
+        finalPayload: {
+          messages: [
+            {
+              role: "user",
+              content: [{ type: "image_url", url: "https://example.test/image.png" }],
+            },
+          ],
+        },
+        transport,
+      });
+      return createAttemptResult();
+    });
+    const attemptParams = createAttemptParams(runSafety);
+    attemptParams.model = {
+      ...attemptParams.model,
+      contextWindow: undefined,
+    } as AgentHarnessAttemptParams["model"];
+
+    await runAgentHarnessAttemptV1({
+      handler,
+      legacyHandlerPresent: false,
+      attemptParams,
+    });
+
+    expect(transport).toHaveBeenCalledOnce();
+    expect(runSafety.controller.terminationReason).toBeUndefined();
+    expect(runSafety.controller.snapshot().promptExposure).toMatchObject({
+      estimateUnavailableDispatchCount: 1,
+      pendingObservationDispatchCount: 0,
+      unavailableReasonCounts: {
+        unknown_media_without_context_window: 1,
+      },
+    });
+  });
+
+  it("requires the same versioned seam for harness compaction", async () => {
+    const runSafety = createRunSafety();
+    const compactParams = {
+      runId: "run-1",
+      runSafety,
+    } as AgentHarnessCompactParams;
+    const transport = vi.fn(async () => "compacted");
+    const handler = createAgentHarnessCompactV1(async (_params, host) => {
+      await host.dispatch({
+        finalPayload: { operation: "compact", threadId: "thread-1" },
+        transport,
+      });
+      return { ok: true, compacted: true };
+    });
+
+    await runAgentHarnessCompactV1({
+      handler,
+      legacyHandlerPresent: false,
+      compactParams,
+    });
+
+    expect(transport).toHaveBeenCalledOnce();
+    expect(runSafety.controller.snapshot().providerDispatchCount).toBe(1);
+  });
+});
